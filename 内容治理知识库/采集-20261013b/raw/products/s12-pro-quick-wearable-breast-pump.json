{"id": 8782433452230, "title": "S12 Pro Quick Wearable Breast Pump", "body_html": "<p><strong>Momcozy S12 Pro Quick – Reliable Pumping, Gentle Care</strong></p>\n<p>Experience a beautifully upgraded pump that fits seamlessly into your daily rhythm.<br>Momcozy S12 Pro Quick is designed to make every pumping session easier, faster, and more comfortable so you can focus on what truly matters.</p>\n<p>With powerful -292 mmHg suction and the exclusive DoubleFit™ hybrid flange, S12 Pro Quick delivers up to 28.2% faster pumping and 6% more milk output than the previous model.</p>\n<p><br>Every detail—from the streamlined 4-part setup to the grip tab design—is made for effortless use, easy cleaning, and a secure, leak-free fit.</p>\n<h6><br></h6>\n<p> </p>", "vendor": "Momcozy", "product_type": "Breast Pump", "created_at": "2026-02-11T03:01:42-05:00", "handle": "s12-pro-quick-wearable-breast-pump", "updated_at": "2026-10-13T03:54:50-04:00", "published_at": "2026-03-04T22:23:32-05:00", "template_suffix": "s12pro-quick-product-1", "published_scope": "global", "tags": "Breastfeeding supplies, S12 Pro Quick, S系列主机, Top100_Sales, wearable breast pump, 吸奶器, 吸奶器主机主链", "variants": [{"id": 45528303861958, "product_id": 8782433452230, "title": "Double / White", "price": "118.99", "sku": "BP335-WH71000B00103-A", "position": 1, "compare_at_price": "139.99", "fulfillment_service": "manual", "inventory_management": null, "option1": "Double", "option2": "White", "option3": null, "created_at": "2026-02-11T03:01:44-05:00", "updated_at": "2026-10-13T03:54:50-04:00", "taxable": true, "barcode": "680339735219", "grams": 500, "image_id": 42154213212358, "weight": 0.5, "weight_unit": "kg", "tax_code": "", "requires_shipping": true, "quantity_rule": {"min": 1, "max": null, "increment": 1}, "price_currency": "USD", "compare_at_price_currency": "USD", "quantity_price_breaks": []}, {"id": 45528303894726, "product_id": 8782433452230, "title": "Double / Pink Gradient", "price": "118.99", "sku": "BP335