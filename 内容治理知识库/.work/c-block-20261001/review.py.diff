+def _decision_reasons(res):
+    """把 review.py :709-715 那个 if/elif 链**读出来**（不改它），供 decision_trace 记录。"""
+    st, fs = res.get("state"), res.get("findings") or []
+    if st == "拒答":
+        return ["no_rule_hit_and_no_coverage_signal"]     # 无命中又不认识主题 → 拒答
+    if st == "BLOCK":
