  },
  "fetch_rule": {
    "rule": "按「有没有文本内容」取数，不按 status 字段筛",
    "impl": "resources with non-empty segments/tables OR media_refs[].ocr_char_count>0 OR visual_description",
    "why": "status 有历史错误（77 条图片 OCR 已完成却标 pending_ocr），用 status 白名单会把已完成产物当待处理跳过"
  },
  "splitters": {
    "entry": {
      "kb_type": "wording",
      "minimal_unit": "一个词条",
      "status": "ready_and_run",
      "how": "每个 field_value / paragraph / list_item / table_row 各成一个 entry；heading_path 记来源字段名"
    },
    "revision_pair": {
      "kb_type": "wording（+ internal_sample 专家修订表）",
      "minimal_unit": "一对修订",
      "status": "ready_and_run",
      "how": "【前】修订位置（原文引用）/ 风险原句示例 ＋【后】修订内容 / 建议文案EN ＋【原因】修订原因 / 中文释义 / 判定理由／规则依据与边界／备注 —— 三者合成一个单元，不可拆散；pair_id 取自 L0 记录，pair_ref 互指同组下一侧"
    },
    "clause": {
      "kb_type": "external_standard",
      "minimal_unit": "一个法条",
      "status": "ready_and_run",
      "how": "章/节/条；正则识别 第X条(之Y) / §X.X / Art. N / Article N / Section N / N.N.N；段内多项可拆；同 clause_label 相邻段按物理续接合并（joined_parts 标记）"
    },
    "sample": {
      "kb_type": "internal_sample",
      "minimal_unit": "一条正负样本",
      "status": "ready_and_run",
      "ran_at": "20260924-1210",
      "resource_count": 201,
      "unit_count": 201,
      "how": "一条记录 = 一个样本单元；polarity 取源侧「分类」（正例/反例，枚举外或缺失 → unknown）；sample_body = 原文反馈 + 文字素材 + 该记录全部图片附件的 OCR 文本（用 \\n\\n 连接）；附件不平铺，父子关系用 media_refs[].resource_id + parent unit 表达",
      "fields": [
        "polarity",
        "sample_body",
        "reason_category",
        "reason_analysis",
        "advice",
        "material_type",
        "channel",
        "media_refs"
      ],
      "excluded": {
        "备注（如处理结果/建议）": "L0 已改判 other（行政元数据），不取任何内容"
      }
    },
    "attribute": {
      "kb_type": "product_desc",
      "minimal_unit": "一条属性",
      "status": "ready_and_run",
      "ran_at": "20260924-1210",
      "resource_count": 3,
      "unit_count": 7,
      "how": "按 (sku, attribute_name) 一条单元；sku 从 型号/产品名/品线/产品/SKU 字段取，取不到 unknown；同一属性的多个值不拆成多条"
    }
  },
