        writes: "kb/l4/runs/<RUN>.json ｜ <RUN>-dryrun.json ｜ <RUN>.report.md ｜ <RUN>.ops.log"
        role: "**L4 落章引擎**（它写顶层 `skill` 供 E2 消费）"
      fix_l4_repromote:
