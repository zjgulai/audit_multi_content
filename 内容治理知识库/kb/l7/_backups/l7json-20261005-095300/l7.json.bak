 "retrieval": {
  "order": [
   "P0 确定性匹配（kb/l5/matcher.py）",
   "规则层（kb/l3/candidates/rules.jsonl，按 kb_type + 关键词）",
   "单元层（kb/l6/retriever.py，BM25 主 / 向量补）",
   "原文层（按锚点回 kb/l0/records 或 kb/l0/snapshots）"
  ],
  "default_mode": "bm25_only",
  "why_bm25_first": "L6 实测：同一查询集上 bm25_only 的 A 组 hit@3 = 1.0 / p@3 = 0.958，hybrid（等权 RRF）0.875 / 0.542，vector_only 0.625 / 0.25；等权 RRF 反而拉低精确度（中文侧最明显）",
  "forbid_equal_rrf_default": true,
  "gate": {
   "bm25_raw_min": 8.0,
   "vector_cosine_min": 0.6,
   "use_raw_scores_only": true,
   "why_not_rrf": "RRF 分恒为 1/(60+k)，实测 Top1 恒在 0.016393，A 组与 B 组看起来一样高，没有区分度，不能当门限",
   "why_single_threshold_not_enough": "实测 BM25 原始分在 A/B 两组有重叠（A 组最低 5.32 < B 组最高 10.02），所以门限只用于「够不够格当参考」，要成为「依据」还必须同时命中规则层",
   "measured": {
    "bm25_raw": {
     "A_group_min": 5.32,
     "A_group_median": 12.76,
     "B_group_median": 6.44,
     "B_group_max": 10.02,
     "source": "kb/l6/selftest.json → raw_score_comparison"
    },
    "cosine": {
     "A_group_min": 0.512,
     "A_group_median": 0.669,
     "B_group_median": 0.384,
     "B_group_max": 0.569,
     "source": "kb/l6/selftest.json → raw_score_comparison"
    }
   },
   "threshold_reasoning": "BM25 门限取 8.0：落在 A 组最低(5.32)与 B 组最高(10.02)之间、贴近两组中位之间，偏保守；余弦门限取 0.60：实测它是唯一能把 B 组全部挡在外面的取值（B 组最高 0.569），代价是 A 组丢 2 条；即便如此门限仍单独不可靠，必须叠加「同时命中规则层」才算依据",
   "below_threshold_label": "参考",
   "above_threshold_without_rule_hit": "仍只能标参考，不得作为依据",
   "coverage_bm25_min": 16.0,
   "coverage_reasoning": "PASS 必须建立在「知识库认识这个主题」之上，覆盖信号二选一：① 命中允许表述（安全词）规则；② 单元层 Top3 里有一条既被规则引用、BM25 原始分又 ≥ coverage_bm25_min(=16.0)。16.0 = 依据门限的 2 倍：实测 A 组中位 12.76 / 最高 23.16，B 组最高 10.02，取 16 能把实测 B 组全部挡在外面。覆盖信号不成立 → 拒答，不得输出 PASS。"
  },
  "vector_fallback": {
   "when": "BM25 原始分最高值 < bm25_raw_min",
   "what": "改用 kb/l6 的向量索引补召；命中仍受两重约束：余弦 ≥ cosine_min 且同时命中规则层才算依据",
   "must_annotate": "检索结果与最终结论里显式标注本次用了向量补召"
  },
  "no_silent_degradation": {
   "how": "读 kb/l6/registry/l6.json 的 retrieval_capability.mode 与 semantic_recall；若为 bm25_only / semantic_recall=false，则检索结果与最终结论必须显式标注「无语义召回」"
  },
  "no_hit_semantics": {
   "bm25_only": "字面未匹配，不代表合规",
   "vector_only": "语义未匹配，不代表合规",
   "hybrid": "字面与语义均未匹配，但仍不代表合规"
  },
  "no_hit_semantics_source": "kb/l6/registry/l6.json → retrieval_capability.no_hit_semantics（原文照搬，不得改写）",
  "refusal_owner": "拒答只能在 skill 层实现：L6 实测 B 组三种模式 hit@3 全为 0 却都返回了 Top3，索引层没有拒答能力"
 },
 "decision_rules": {
  "finding_requires": "P0 命中 或 规则层命中（rule.forbidden_expression 片段在正文里逐字命中）",
  "BLOCK": [
   "P0 命中（kb/l5/matcher.py）",
   "规则层命中且 rule.p_level = P0",
   "规则层命中且 rule.risk_level = 高危·红"
  ],
  "REVIEW": [
   "规则层命中但既非 P0 也非高危·红（需人工判断语境）",
   "同一处内容同时命中允许表述（安全词）与疑似违规表述，需人工定夺"
  ],
  "PASS": [
   "无 P0 命中、无规则层命中，且检索到的依据足以覆盖该主题（至少一条单元层结果 ≥ 门限，或命中过该主题的规则）"
  ],
  "refuse": [
   "无 P0 命中、无规则层命中，且单元层最高原始分 < 门限（BM25 与余弦都没过）",
   "即：检索不到依据 → 按 no_hit_semantics 拒答，不得输出 PASS"
  ],
  "refusal_must_include": [
   "查了什么（原始查询词）",
   "用了几种模式（BM25 / 向量 / 是否降级）",
   "为什么判断没有依据（分数与门限对比）",
   "no_hit_semantics 原文"
  ],
  "routing": {
   "problems_1_2": "逐条输出（编号 + 类别-子类 + 位置 + 引文 + 原因 + 依据；BLOCK 另给建议）",
   "problems_3_plus": "只输出分类汇总 + 报告链接；完整清单必须真的写到 kb/l7/reports/ 下并在结论里给路径",
   "tail": {
    "PASS": "转 sign-off 责任人",
    "REVIEW": "建议转复核责任人",
    "BLOCK": "请修改后重新提交"
   }
  }
 },
