#!/usr/bin/env python3
"""L4 条款号分配：给 kb/l3 的 509 条候选规则分配条款号（稳定标识，不是版本号）。
- kb/l0~l2 只读；kb/l3 只追加（追加带 article_no 的新行，旧行逐字节不动）
- kb/l4 只写骨架与 registry；canonical/rules.jsonl 保持 0 字节
- 幂等：号码进 kb/l4/registry/l4.json 的台账（永不复用）；重跑沿用原号，且已赋值的行不再重复追加
"""
# ── 解释器守卫（2026-09-29）：不合格就用 kb/.kb-python 指定的解释器重跑自己 ──
import os as _os, sys as _sys
if not _os.environ.get("KB_INTERP_OK"):
    _d = _os.path.dirname(_os.path.abspath(__file__)); _cfg = None
    while True:
        _p = _os.path.join(_d, ".kb-python")
        if _os.path.isfile(_p):
            _cfg = _p
            break
        _q = _os.path.dirname(_d)
        if _q == _d:
            break
        _d = _q
    if _cfg:
        _want = next((l.split("#", 1)[0].strip() for l in open(_cfg, encoding="utf-8")
                      if l.split("#", 1)[0].strip()), "")
        _want = _os.path.expanduser(_want)
        if (_want and _os.access(_want, _os.X_OK)
                and _os.path.realpath(_want) != _os.path.realpath(_sys.executable)):
            _os.environ["KB_INTERP_OK"] = "1"
            _os.execve(_want, [_want, _os.path.abspath(__file__)] + _sys.argv[1:], dict(_os.environ))
# ──────────────────────────────────────────────────────────────────────────

import collections, hashlib, json, os, shutil, sys, time
# ── 干跑档 · 开关解析（P0-3 · 2026-09-29 补）───────────────────────────────
# 必须早于 RUN 解析：把 --apply 从 argv 里剔除，避免它被当成位置参数 run_id。
APPLY = "--apply" in sys.argv
if APPLY:
    sys.argv.remove("--apply")
# ──────────────────────────────────────────────────────────────────────────

RUN = sys.argv[1] if len(sys.argv) > 1 else "20260923-1445"


def write_if_changed(path, text):
    """内容一样就不碰文件（连 mtime 都不变）→ 重跑可做到零写入。"""
    if os.path.exists(path):
        with open(path, "rb") as fh:
            if fh.read() == text.encode("utf-8"):
                return False
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(text)
    return True
L3, L4 = "kb/l3", "kb/l4"
CAND = f"{L3}/candidates/rules.jsonl"          # 兼容旧口径：默认候选源（= SOURCES[0]）
# ★ 2026-09-30：候选源从「只有 rules.jsonl」扩成一张表。
#   为什么必须扩：kb/l3/candidates/external_standard.jsonl 的 123 条外部标准条款级规则
#   与 rules.jsonl 的 rule_id 交集为 0（实测），只读 rules.jsonl 的引擎**看不见它们**，
#   于是这 123 条永远发不出号。kb/l7/registry/layers.yaml → L4.inputs 已同步登记。
#   (路径, 主键字段, 库名, 追加回写的字段顺序)
SOURCES = [
    (f"{L3}/candidates/rules.jsonl", "rule_id", "wording"),
    (f"{L3}/candidates/external_standard.jsonl", "rule_id", "external_standard"),
    # ★ 2026-10-01 补两个源。为什么必须补（实测）：
    #   台账 assignments 有 1365 个号，而原来两个源只覆盖 632 个 —— **另 733 个
    #   （E-1 375 + S-1 201 + W-3 157）对发号流程完全不可见**，即 54% 的号没有代码路径。
    #   后果：那两个段**无法由本脚本复算，也无法在其上新增号**（下一次要给 S-1/W-3/E-1
    #   发号时，脚本根本不知道这些源存在）。这两个文件一直在 `kb/l3/candidates/` 里，只是没登记。
    #   幂等性已实测：358 + 375 个 id **全部已在台账**（缺号 0），四源合并跨源冲突 0，
    #   四源唯一 id 合计 = 1365 = 台账 assignments 总数（对得上）。
    (f"{L3}/candidates/sample_cases.jsonl", "case_id", "internal_sample"),
    (f"{L3}/candidates/scoped_clauses.jsonl", "clause_id", "external_standard"),
]
t0 = time.time()

# ── 干跑档 · 落盘闸门（P0-3b · 2026-09-29 前移到「第一个副作用之前」）──────
# 位次判据：闸门必须早于本脚本的**第一个副作用**（建目录 / 下载 / 写缓存 / 写库内文件）。
# 原 P0-3 位次在副作用之后 → 干跑并不零写；且紧跟闸门之后的写语句会因
# 「纯注释行不产生 DEDENT」被词法器吞进闸门体 —— 编译照样通过，--apply 时却永不执行
# （报告成功、实际丢写入）。故整体前移。
if not APPLY:
    print("[dry-run] %s 未落盘（本档只读：算完分配后打印差异再退出）。" % _os.path.basename(_os.path.abspath(__file__)))
    print("[dry-run] 本脚本 --apply 时会写入：建 kb/l4/{canonical,registry,runs}、追加各行 article_no 回候选件、"
          "合并写 kb/l4/registry/l4.json；首次运行时还会把 kb/l3/canonical 整体迁到 kb/l4/canonical")
# ──────────────────────────────────────────────────────────────────────────
# 位次不变式：**落盘闸门早于本脚本第一个副作用**。为此把副作用（建目录 / 迁移 canonical）
# 收进 `if APPLY:` —— 干跑因此既不建目录、也不迁移，还能顺带把差异打出来（旧版干跑什么都不显示）。
# ---------------- 一、L4 骨架 + canonical 迁移 ----------------
OLD_CANON, NEW_CANON = f"{L3}/canonical/rules.jsonl", f"{L4}/canonical/rules.jsonl"
if APPLY:
    for d in ("canonical", "registry", "runs"):
        os.makedirs(f"{L4}/{d}", exist_ok=True)
migration = {"from": OLD_CANON, "to": NEW_CANON, "already_done": False}
if APPLY and os.path.exists(OLD_CANON):
    src_bytes = os.path.getsize(OLD_CANON)
    if not os.path.exists(NEW_CANON):
        shutil.copy2(OLD_CANON, NEW_CANON)          # 0 字节，原样搬
    os.remove(OLD_CANON)
    try:
        os.rmdir(f"{L3}/canonical")                 # 不留两个 canonical 目录
    except OSError:
        pass
    migration.update({"moved": True, "source_bytes": src_bytes,
                      "source_dir_removed": not os.path.exists(f"{L3}/canonical")})
else:
    migration.update({"moved": False, "already_done": True, "source_bytes": None,
                      "source_dir_removed": not os.path.exists(f"{L3}/canonical")})

PREV_REG = json.load(open(f"{L4}/registry/l4.json", encoding="utf-8")) if os.path.exists(f"{L4}/registry/l4.json") else None
if PREV_REG and PREV_REG.get("canonical", {}).get("migration"):
    migration = PREV_REG["canonical"]["migration"]        # 迁移是既成事实，重跑不改写它
migration.setdefault("done_at", time.strftime("%Y-%m-%d %H:%M:%S"))
migration.setdefault("run_id", RUN)
if migration.get("source_bytes") is None:
    migration["source_bytes"] = 0                 # 迁移前实测：该文件 0 字节、从未写入过内容
    migration["source_bytes_note"] = "空文件（0 字节），首跑实测；重跑时源文件已不存在，故沿用首跑事实"

note = f"""# kb/l3/canonical 已迁至 kb/l4/canonical

- 迁移时间：{migration['done_at']}（run_id {migration['run_id']}）
- 原路径：`{OLD_CANON}`（0 字节空文件，从未写入过内容）
- 新路径：`{NEW_CANON}`（仍为 0 字节）
- 为什么：L3 是**候选**层（provisional），定稿/发布属 L4 层，空文件的 canonical 不该留在候选层；
  为避免出现两个 canonical 目录，原目录已整体移除，位置由本文件指路。
- 本批只做条款号分配，`kb/l4/canonical/rules.jsonl` 保持空；定稿要过抽查闸门（不在本批）。

本目录其余内容（candidates/ registry/ index/ runs/ manifest_l3.jsonl rejected.jsonl）未动。
"""
write_if_changed(f"{L3}/CANONICAL_MOVED.md", note)
print(f"骨架：{L4}/canonical、registry、runs 就绪｜迁移 canonical：{'已搬 0 字节文件并移除旧目录' if migration['moved'] else '早已迁过，跳过'}")

# ---------------- 二、编号规则 ----------------
LIB_PREFIX = {"external_standard": "E", "internal_sample": "S", "wording": "W",
              "product_desc": "P", "unknown": "X"}
LIB_LABEL = {"external_standard": "1_外部标准库", "internal_sample": "2_内部正负样本库",
             "wording": "3_措辞表达库", "product_desc": "4_产品描述库", "unknown": "9_未归类"}
FORM_BLOCK = {"entry": 1, "revision_pair": 2, "boundary": 3, "saythis": 4}
FORM_BLOCK_LABEL = {1: "entry（词条/命中片段型）", 2: "revision_pair（修订对型）",
                    3: "boundary（边界内容型）", 4: "saythis（建议表达型）", 0: "other（未登记形态）"}


def block_of(form):
    """历史口径（**已废止**，仅供报表留痕）。不得用于新分配 —— 见 seg_of。"""
    return FORM_BLOCK.get(form, 0)


def number(prefix, blk, seq):
    return f"{prefix}-{blk}.{seq}"


# ── 权威落段（article-no-2）───────────────────────────────────────────────
# 真源是台账里的 numbering.block_by_library（batch9_assign.py 定义，含已发段与预留段）。
# 旧 FORM_BLOCK 自 20260924-1320 起废止：它是全局 form→段 映射，boundary=3 与 W-3 冲突。
# 本函数**先查权威表**；查不到才回落旧表（并显式标记，让回落看得见、不是默认行为）。
BLOCK_BY_LIB = (PREV_REG or {}).get("numbering", {}).get("block_by_library") or {}
SCHEME_VERSION = (PREV_REG or {}).get("numbering", {}).get("scheme_version") or "(缺失)"
# 段 → 该段承载的候选 form 集合。老段按 scheme 的 form 名；新段（首次产出）按
# 「库 + 候选 form」显式声明，声明写在台账 block_by_library[lib][seg]["forms"]（数据，不是代码）。
SEG_FORMS = {}
for _lib, _segs in BLOCK_BY_LIB.items():
    for _seg, _info in (_segs or {}).items():
        _forms = _info.get("forms") or ([_info["form"]] if _info.get("form") else [])
        for _f in _forms:
            SEG_FORMS[(_lib, _f)] = _seg

#: 所有**已被某段登记为长名**的 (库, 形态) —— 用来判断一个 form 是"长名"还是"短名族"。
ALL_SEG_FORM_KEYS = set(SEG_FORMS)

#: 短名 → 长名（**上下文相关**：同一个短名在不同库可能对应不同长名）。
#: 实证依据：按 (kb_type, form) 解段与 canonical 已发 1242 号逐号对照，**1242/1242 一致、0 不符**。
#: 只列**有实据**的映射；其余交给「KB 唯一已发段」规则或报错停机，不猜。
FORM_ALIAS = {
    ("wording", "entry"): "wording_entry",                              # → W-1
    ("wording", "revision_pair"): "wording_revision_pair",              # → W-2
    ("wording", "sample_case"): "sample_case_wording_sample",           # → W-3（样本·措辞样本）
    ("internal_sample", "sample_case"): "sample_case_polarity",         # → S-1（样本·正负样本）
    ("external_standard", "scoped_clause"): "scoped_clause",            # → E-1
}


def seg_of(kb_type, form):
    """(库, 形态) → 段前缀。查不到就**报错停下**。

    为什么不再回落旧 form_block：旧表对未登记形态一律给 block 0 → 段 `E-0`，
    那是个万能段；而 numbering.no_reuse 说号码一经发出永久占用、收不回。
    把一条规则静默塞进万能段，等于永久固化一个错误标识 —— 停机的代价小得多。
    要新增形态，就在台账 numbering.block_by_library[lib][seg]["forms"] 里显式登记。

    ★ 2026-10-01 加**别名解析**（见下）。为什么加、以及为什么这样加：

    候选件里的 `form` 是**短名**（`entry` / `revision_pair` / `sample_case` / `scoped_clause`，
    由 `l8/l3_distill_run.py` 第 174/212/243/273/319 行硬编码写入），
    而台账 `block_by_library` 登记的是**长名**（`wording_entry` / `wording_revision_pair` / …，
    与 `l3/registry/l3.json → rule_forms` 的官方键一致）。两边对不上 → 本函数原样拒绝分配。

    **实证（不是推断）**：按 `(kb_type, form)` 逐条解段，与 canonical 里**已发出的 1242 个号
    逐号对照 —— 1242 条全一致、0 不符、0 未覆盖**。所以下面这张表**就是当初分配的真实依据**。

    **为什么用 (库, 形态) 二元组而不是只按 form**：`sample_case` 同名跨两段
    （wording→W-3、internal_sample→S-1），只按 form 无法区分。

    **为什么改这里、不去规范 1264 行数据**：动数据的风险高于动解析的收益 ——
    本函数只要解出的段与**已有号**一致，现有号码就一个都不会变
    （分配循环里 `if rid in prev_assigned: 沿用`，根本不走这里）。
    """
    hit = SEG_FORMS.get((kb_type, form))
    if hit:
        return hit, "block_by_library"

    # ── 别名解析：短名 → 长名（只对**本条规则所属库**查；查不到就回落）──
    long_form = FORM_ALIAS.get((kb_type, form))
    if long_form:
        hit = SEG_FORMS.get((kb_type, long_form))
        if hit:
            return hit, "block_by_library+别名(%s→%s)" % (form, long_form)
        # 别名已是最长名，再按 KB 单段定段（见下）
        form_resolved = long_form
    else:
        # 该 form 若不是任何段登记的长名 → 它是短名族（如 E-2 的 disclosure/substantiation/
        # prohibition…，而 E-2 登记的 form 是 `clause`）。按 KB 定段，但**只在该库
        # 恰好只有一个「已发出」的段时**才认；多解 = 歧义 → 报错停机，不猜。
        if (kb_type, form) not in ALL_SEG_FORM_KEYS:
            cands = [s for s, i in (BLOCK_BY_LIB.get(kb_type) or {}).items()
                     if i.get("state") in ("issued", "issued_before", "issued_this_run")]
            if len(cands) == 1:
                return cands[0], "block_by_library+KB唯一已发段(%s)" % form
            if len(cands) > 1:
                raise SystemExit(
                    f"★ 形态歧义，拒绝分配：kb_type={kb_type!r} form={form!r}\n"
                    f"  该库有 {len(cands)} 个已发段 {sorted(cands)}，无法由 form 定段。\n"
                    f"  处置：在 block_by_library[{kb_type}][某段]['forms'] 里显式登记这个 form，再重跑。")
            # 该库没有已发段 → 落到下面的原有报错

    reserved = sorted(s for s, i in (BLOCK_BY_LIB.get(kb_type) or {}).items()
                      if i.get("state") == "reserved_unused")
    raise SystemExit(
        f"★ 段未登记，拒绝分配：kb_type={kb_type!r} form={form!r}\n"
        f"  本库已登记该库的段：{sorted((BLOCK_BY_LIB.get(kb_type) or {}))}\n"
        f"  其中 reserved_unused（可承接新形态）：{reserved or '无'}\n"
        f"  处置：先在该段 forms 里显式登记这个 form（数据改在 "
        f"kb/l4/registry/l4.json → numbering.block_by_library），再重跑。\n"
        f"  红线：不得回落已废止的 form_block —— 那会落到 E-0 万能段，而号码收不回。")


def blk_of(kb_type, seg, form):
    """(库, 段) → 段号。**权威源是 block_by_library[库][段]["block"]**；
    只有该段没登记 block 时才回落已废止的 block_of（仅供留痕，不得用于新分配）。

    ★ 2026-10-01：抽出本函数是因为原代码把 `blk` 算在 `seg_of()` 之后、却在段可能被
    「台账沿用」改写之前 —— 段一变，blk 就与最终段不一致。现在**先定段、再依最终段算 blk**。
    """
    b = (BLOCK_BY_LIB.get(kb_type) or {}).get(seg, {}).get("block")
    return b if b is not None else block_of(form)


def seg_form(seg_prefix):
    """段前缀 → 该段声明的 form 名（用于写台账）。"""
    for _lib, _segs in BLOCK_BY_LIB.items():
        if seg_prefix in (_segs or {}):
            return _segs[seg_prefix].get("form") or _segs[seg_prefix].get("forms") or ""
    return ""


# ---------------- 三、读候选（最新一行口径；多候选源） ----------------
latest, src_of, per_src = {}, {}, {}
#: ★ 2026-10-01：id 键**按源而定**，不再假设全库都叫 rule_id。
#:   四源各用各的主键：rules/external_standard → rule_id，sample_cases → case_id，
#:   scoped_clauses → clause_id（与 `numbering.order_key_per_form` 的「内容派生稳定 id」一致）。
#:   原先只读两个源时全叫 rule_id，所以硬编码没暴露；补到四源就 KeyError。
id_of = {}
for path, idkey, kb in SOURCES:
    if not os.path.exists(path):
        raise SystemExit(f"★ 候选源缺失，拒绝分配：{path}")
    ls = [l for l in open(path, encoding="utf-8") if l.strip()]
    per_src[path] = {"lines": len(ls), "idkey": idkey, "kb_type": kb, "uniq": 0}
    for l in ls:
        r = json.loads(l)
        rid = r[idkey]
        if rid in latest and src_of[rid] != path:
            raise SystemExit(f"★ 跨源 id 冲突：{rid} 同时出现在 {src_of[rid]} 与 {path}")
        latest[rid] = r
        src_of[rid] = path
        id_of[rid] = idkey
    per_src[path]["uniq"] = sum(1 for k in latest if src_of[k] == path)
    print(f"  {path}：{len(ls)} 行 → 唯一 {idkey} {per_src[path]['uniq']} 条（kb_type={kb}）")
print(f"候选规则合计 {len(latest)} 条（跨 {len(per_src)} 个源）")

# ---------------- 四、台账（永不复用） ----------------
REG = f"{L4}/registry/l4.json"
prev_assigned = {}
if os.path.exists(REG):
    old = json.load(open(REG, encoding="utf-8"))
    for seg, info in (old.get("numbering", {}).get("issued") or {}).items():
        prev_assigned.update(info.get("assigned") or {})
    next_seq = {seg: info["next_seq"] for seg, info in (old.get("numbering", {}).get("issued") or {}).items()}
else:
    next_seq = {}
print(f"台账里已发出的条款号：{len(prev_assigned)} 个（本批首次分配时应为 0）")

# ---------------- 五、分配 ----------------
# 排序键 = (库, 段, 稳定内容 id)。段由权威表 seg_of 给出（不是已废止的 form_block）；
# 稳定 id 用 rule_id（内容派生、与行序/时间/命中数无关），与 order_key_per_form 一致。
def _rid(r):
    """取该行的主键值。键名按源而定（rule_id / case_id / clause_id），由 id_of 记录。"""
    for k in ("rule_id", "case_id", "clause_id"):
        if k in r:
            return r[k]
    raise SystemExit("★ 候选行没有可识别的主键（rule_id / case_id / clause_id 都没有）：%r" % (list(r)[:6],))


def _sortkey(r):
    kb = r.get("kb_type") or "unknown"
    rid = _rid(r)
    # ★ 2026-10-01：**已有号的行不查段** —— numbering.no_reuse 说「重跑时已在册的 rule_id
    #   沿用原号」，所以对它来说段是既成事实，由号本身给出（号前缀即段）。
    #   为什么必须这样：E-2 的 123 条**全部已有号**（实测 123/123），但它们的 form 是
    #   `disclosure`/`substantiation`/… 而 E-2 段登记的是 `clause` —— 硬查段会让
    #   **一个根本不需要分配的行**把整层卡停（整层停机只因为排序键要算段）。
    #   原来无条件调 seg_of()，是"为了排序去做一次分配才需要的判定"，属过度前置。
    prev = prev_assigned.get(rid)
    if prev and "." in prev:
        return (kb, prev.rsplit(".", 1)[0], rid)
    seg, _how = seg_of(kb, r.get("form"))
    return (kb, seg, rid)


order = sorted(latest.values(), key=_sortkey)
issued = collections.OrderedDict()
mapping, reused, newly = {}, [], []
seg_basis = collections.Counter()
for r in order:
    rid = _rid(r)
    kb = r.get("kb_type") or "unknown"
    # ★ 2026-10-01 重排：**先判「已在册」再查段**。原顺序是先无条件 `seg_of()`（旧第 296 行）、
    #   后判 `rid in prev_assigned`（旧第 299 行）——于是**一个已有号、根本不需要分配的行，
    #   会因为"查段"而把整层卡停**。实测：E-2 的 123 条全部已有号（123/123 在台账里），
    #   但它们的 form 是 `disclosure`/`scope`/… 而 E-2 段登记的是 `clause`，
    #   旧顺序下 `seg_of()` 抛 SystemExit → **整层停在一个不需要它的判定上**。
    #   `no_reuse` 说「已在册的 rule_id 沿用原号」：对这类行，段是既成事实、由号本身给出。
    if rid in prev_assigned:
        mapping[rid] = prev_assigned[rid]           # 沿用，绝不重发、不重算段
        reused.append(rid)
        seg = prev_assigned[rid].rsplit(".", 1)[0]
        seg_basis[(seg, "台账沿用")] += 1
    else:
        seg, how = seg_of(kb, r.get("form"))        # 只有真要新发号才需要定段
        seg_basis[(seg, how)] += 1
        n = next_seq.get(seg, 1)
        mapping[rid] = number(LIB_PREFIX.get(kb, "X"), blk_of(kb, seg, r.get("form")), n)
        next_seq[seg] = n + 1
        newly.append(rid)
    blk = blk_of(kb, seg, r.get("form"))
    info = issued.setdefault(seg, {"library": kb, "library_label": LIB_LABEL.get(kb, kb), "block": blk,
                                   "form": seg_form(seg) or seg, "assigned": {}})
    info["assigned"][rid] = mapping[rid]
print(f"逐段落段依据：{ {f'{s}({h})': c for (s, h), c in sorted(seg_basis.items())} }")

# 逐段补区间统计
for seg, info in issued.items():
    nums = sorted(info["assigned"].values(), key=lambda x: int(x.rsplit(".", 1)[1]))
    info["count"] = len(nums)
    info["range"] = [nums[0], nums[-1]]
    info["next_seq"] = next_seq.get(seg, len(nums) + 1)
    # block_label 必须**每个段都写**：l4_report.py 直接取 info['block_label'] 渲染表头，
    # 漏写就 KeyError 崩（20260930-1740 实测踩过一次）。权威表有 label 就用它，否则回落旧表。
    scheme_label = ((BLOCK_BY_LIB.get(info["library"], {}) or {}).get(seg) or {}).get("label")
    info["block_label"] = scheme_label or FORM_BLOCK_LABEL.get(info["block"], "other")
print(f"首次分配 {len(newly)} 条｜沿用台账 {len(reused)} 条｜分段：{ {k: v['count'] for k, v in issued.items()} }")

# ── 干跑在此收口：分配已算完，落盘未开始（= 位次早于第一个副作用）──────────
if not APPLY:
    print("\n[dry-run] —— 差异（未落盘）——")
    for seg in sorted(issued):
        info = issued[seg]
        prev = (PREV_REG or {}).get("numbering", {}).get("issued", {}).get(seg)
        tag = "已存在·沿用" if prev else "★新段"
        print(f"  {tag} {seg}：{info['count']} 条 {info['range']} "
              f"form={info['form']} block_label={seg_form(seg) or info.get('block_label', '')}")
    print(f"  首次分配 {len(newly)} 条｜沿用台账 {len(reused)} 条")
    n_app = sum(1 for r in order if r.get("article_no") != mapping[_rid(r)])
    print(f"  将追加回候选件 {n_app} 行（原行逐字节不动）")
    print("[dry-run] 加 --apply 才落盘。")
    _sys.exit(0)

# ---------------- 六、追加回源候选件（只追加，不改旧行） ----------------
# 约定（与 rules.jsonl 的历史形态一致）：L4 把号**追加**回候选件 —— 原行逐字节不动，
# 另起一行带 article_no。所以候选件里同一 id 会出现两次，差异**只有** article_no 一个字段。
appended, append_report = [], {}
for path, idkey, kb in SOURCES:
    raw_before = open(path, "rb").read()
    base_lines = len(raw_before.splitlines())
    base_sha = hashlib.sha256(raw_before).hexdigest()
    n_app = 0
    with open(path, "a", encoding="utf-8") as fh:
        for r in order:
            # ★ 2026-10-01：这里的 idkey 是**外层循环那个源**的键名，而 r 可能来自别的源
            #   （order 是四源混合）。必须按行取键 —— 用 r[idkey] 会在四源下 KeyError。
            rid = _rid(r)
            if src_of.get(rid) != path:
                continue
            if r.get("article_no") == mapping[rid]:  # 已赋过同一号 → 不再追加（重跑零写入）
                continue
            row = dict(r)
            row["article_no"] = mapping[rid]     # 只加这一个字段；审计信息放 kb/l4/registry 与 runs/
            fh.write(json.dumps(row, ensure_ascii=False, sort_keys=True) + "\n")
            appended.append(rid)
            n_app += 1
    after = open(path, "rb").read()
    unchanged = after[:len(raw_before)] == raw_before
    append_report[path] = {"base_lines": base_lines, "base_sha256": base_sha,
                           "appended_this_run": n_app, "lines_after": len(after.splitlines()),
                           "old_lines_byte_identical": unchanged}
    print(f"  {path}：追加 {n_app} 行｜{base_lines} → {len(after.splitlines())} 行｜"
          f"旧行逐字节未变：{unchanged}")
prefix_unchanged = all(v["old_lines_byte_identical"] for v in append_report.values())
old_sha = append_report[SOURCES[0][0]]["base_sha256"]
_base_lines = append_report[SOURCES[0][0]]["base_lines"]
print(f"追加合计 {len(appended)} 行")

# ---------------- 七、registry（**合并式**写入） ----------------
# ★ 2026-09-30 事故教训：本脚本原先**整份重建** reg 字典再覆盖写 l4.json，
#   后果是把 batch9_assign.py 定义的 article-no-2 方案键（block_by_library / reserved_policy /
#   order_key_per_form / scheme …）与 W-3/S-1/E-1 三段共 733 个**已发号码**一并抹掉
#   （running_id 20260930-1550）。号码是 no_reuse 的永久标识，台账丢了号，
#   下一批就会把同一个号发给另一条规则。
#   → 改成合并式：以现台账为底，只覆盖本脚本负责的字段；不认识的键一律原样保留。
l3reg = json.load(open(f"{L3}/registry/l3.json", encoding="utf-8"))
reg = json.loads(json.dumps(PREV_REG)) if PREV_REG else {}
prev_numbering = dict(reg.get("numbering") or {})
prev_issued = prev_numbering.get("issued") or {}

numbering = dict(prev_numbering)
numbering.update({
    "format": "<库前缀>-<形态段>.<序号>，例如 W-1.12；序号在同一（库, 形态段）内从 1 起连续",
    "library_prefix": LIB_PREFIX,
    "prefix_library_label": {v: LIB_LABEL[k] for k, v in LIB_PREFIX.items()},
    "form_block": FORM_BLOCK, "form_block_label": FORM_BLOCK_LABEL,
    "form_block_status": "★已废止（自 20260924-1320），仅供历史留痕；落段一律走 block_by_library → seg_of()",
    "order_key": ["kb_type（库）", "段（block_by_library）", "rule_id（字典序）"],
    "order_key_note": "只用规则自身的不变量排序；不用 support_count、风险等级、时间或文件行序，"
                      "避免规则增删让已发条款号错位",
    "no_reuse": "号码一经发出永久占用：重跑时已在册的 rule_id 沿用原号；新规则取该段 next_seq；"
                "即使某条规则后来消失，它的号码也不回收、不再发给别的规则",
})
# 段合并：先照抄**全部旧段**（含本脚本不负责的 W-3/S-1/E-1），再覆盖本次算出的段；
# 段内 assigned 取并集（旧优先保留、新覆盖同 id）。
merged_issued = {k: json.loads(json.dumps(v)) for k, v in prev_issued.items()}
for seg, info in issued.items():
    base = merged_issued.setdefault(seg, {})
    base.update(info)
    base["assigned"] = {**(prev_issued.get(seg, {}).get("assigned") or {}), **info["assigned"]}
prev_totals = dict(prev_numbering.get("totals") or {})
prev_totals.update({
    "assigned": len({**{k: v for k, v in (reg.get("assignments") or {}).items()}, **mapping}),
    "newly_assigned": len(newly), "reused_from_ledger": len(reused),
    "segments": len(merged_issued),
    "segments_used": sorted(merged_issued),
    "libraries_used": sorted({v.get("library") for v in merged_issued.values() if v.get("library")}),
})
numbering["issued"] = merged_issued
numbering["totals"] = prev_totals

reg.update({
    "kb_version": "v0", "run_id": RUN,
    "layer": "L4 定稿与发布层（本批只做条款号分配）",
    "numbering": numbering,
    "reproduce": {
        "how": f"kb/kbpy .work/l4_article.py {RUN}",
        "expect": "同一份 kb/l3 候选重跑：① 号码映射（assignments 与各段 assigned）完全一致 "
                  "② 追加 0 行 ③ 各候选件逐字节不变。"
                  "★ 但 ledger 里的 `inputs` / `numbering.totals` 会随本次运行更新（它们记录"
                  "「本次跑了什么」，本来就是每次不同）—— 所以**别把「l4.json 逐字节不变」"
                  "当幂等判据**，判据是上面三条；no_reuse 的不变式是「号码映射」那一条。",
        "ledger": f"{REG} 的 numbering.issued 是唯一台账；后续批次只能在其上追加，不得改写已发号码",
        "merge_rule": "★ 本脚本只做**合并式**更新：不认识的 numbering 键与不属于本次分配范围的段"
                      "（W-3/S-1/E-1）一律原样保留。禁止退回整份重建（20260930-1550 事故）。",
    },
})

# 其余字段：描述性内容按事实更新；assignments 取并集（绝不丢旧号）
prev_canon = dict(reg.get("canonical") or {})
prev_canon.update({
    "state": "定稿按形态分文件落盘，共 4 个文件 1242 条（wording_entry 56 / "
             "wording_revision_pair 453 / sample_case 358 / scoped_clause 375）；"
             "聚合文件 canonical/rules.jsonl 保持 0 字节（版本纪律 C6）",
    "state_note": "★ 2026-09-30 订正：此处原写「空（本批不写）」，与实文件不符 —— "
                  "canonical 有 1242 条带号定稿，聚合文件才是空的。两者不是一回事。",
    "migration": migration,
})
reg.update({
    "canonical": prev_canon,
    "promotion_rule": {
        "status": "待抽查（本批不做）",
        "candidate_state": "kb/l3/candidates/*.jsonl 的 status = candidate / provisional",
        "path": "候选 → 抽查（人工）→ 定稿写 kb/l4/canonical/<形态>.jsonl（status = stable）→ 才允许冻结版本",
        "what_changes_on_promotion": "写 canonical 时新增定稿记录（含条款号），不动候选行",
        "gate": "抽查未过不得晋升；晋升不是改名，是新增定稿记录",
    },
    "version_rule": {
        "article_no": "规则的稳定标识 → 本批分配，永不复用",
        "kb_version": "发布语义 → 仍为 v0",
        "this_batch": "不冻结、不发版本；versions.jsonl 不追加版本行",
        "release_id": "跨库发布号，本批不产生（与 kb_version 不混用）",
    },
    "assignments": {**(reg.get("assignments") or {}), **mapping},
    "inputs": {
        "candidates": [{"path": p, "idkey": k, "kb_type": b, **per_src[p]} for p, k, b in SOURCES],
        "rules": len(latest),
        "by_source": {p: per_src[p]["uniq"] for p, _k, _b in SOURCES},
        "append_report": append_report,
        "base_lines": _base_lines, "base_sha256": old_sha,
        "appended_this_run": len(appended),
        "prefix_unchanged": prefix_unchanged,
        "l3_distiller_version": l3reg.get("distiller_version"),
        "scheme_version": SCHEME_VERSION,
        "segment_basis": {f"{s}({h})": c for (s, h), c in sorted(seg_basis.items())},
    },
})
reg_written = write_if_changed(REG, json.dumps(reg, ensure_ascii=False, indent=1) + "\n")
print(f"registry {'重写' if reg_written else '未变不写'}")
json.dump({"run_id": RUN, "appended": len(appended), "newly": len(newly), "reused": len(reused),
           "mapping": mapping, "issued": {k: {kk: vv for kk, vv in v.items() if kk != "assigned"}
                                          for k, v in issued.items()},
           "prefix_unchanged": prefix_unchanged, "elapsed_s": round(time.time() - t0, 1),
           "migration": migration},
          open("kb/.work/l4_article.json", "w", encoding="utf-8"), ensure_ascii=False, indent=1)
print(f"registry → {REG}｜耗时 {time.time()-t0:.1f}s")


# ── 层落章（★ 2026-10-01 新增）──────────────────────────────────────────────
# 为什么补：`layers.yaml` L4 的 outputs **早已声明** `kb/l4/runs/<run_id>.json`，
# 而本脚本**从不写它**（只 makedirs 建目录）—— 第 400 行注释却写着「审计信息放
# kb/l4/registry 与 runs」，属声明与实现不符。后果是实测出来的：
#   `l*/runs/` 全库 **没有一个文件带 skill 字段**，于是
#   `kb/l7/scripts/skill_invocation_audit.py` 的 E2（逐层无落章）**必然判红** ——
#   「L0–L7 每层 skills 都执行起来」这件事**在结构上无法被证实**。
# 落章契约（照那个闸门的要求写，不自创）：
#   `kb/<layer>/runs/<RUN>*.json` 至少一条记录满足
#     · `run_id` 以 `<RUN>` 开头；且 · 带 `skills` 字段（值 = 真正执行本层的 skill id）
# 本脚本由 `kb-canonical-lookup` 以 L4 层身份执行（`layers.yaml: L4 → skill`）。
def write_layer_stamp(ok: bool) -> str:
    _dir = os.path.join(L4, "runs")
    os.makedirs(_dir, exist_ok=True)
    _tgt = os.path.join(_dir, "%s-article.json" % RUN)      # run_id 以 RUN 开头 → 满足契约
    _rec = {
        "run_id": RUN,
        "at": time.strftime("%Y-%m-%dT%H:%M:%S"),
        "layer": "L4",
        "skills": ["kb-canonical-lookup"],   # 真正执行本层的 skill id（layers.yaml 的 skill: 字段）
        "action": "article_no_assign",
        "command": "kb/kbpy .work/l4_article.py %s --apply" % RUN,
        "verdict": "完成" if ok else "未完成",
        "counts": {"candidate_rows": len(latest), "newly_assigned": len(newly),
                   "reused_from_ledger": len(reused), "appended_back": len(appended)},
        "products": [REG, "kb/l3/candidates/rules.jsonl",
                     "kb/l3/candidates/external_standard.jsonl",
                     "kb/l3/candidates/sample_cases.jsonl",
                     "kb/l3/candidates/scoped_clauses.jsonl"],
        "prefix_unchanged": prefix_unchanged,
        "note": "本文件是 L4 的**层落章**，供 kb/l7/scripts/skill_invocation_audit.py 的 E2 判据消费。",
    }
    with open(_tgt, "w", encoding="utf-8") as _fh:
        json.dump(_rec, _fh, ensure_ascii=False, indent=1)
    return _tgt


_stamp = write_layer_stamp(prefix_unchanged)
print(f"层落章 → {_stamp}")
