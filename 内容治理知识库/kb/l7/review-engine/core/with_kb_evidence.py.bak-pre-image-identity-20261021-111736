# ── 资源键 → 可点地址：形状判据与 token 解析（2026-10-09 晚，Owner 报「链接无效」）──────
#
# ⚠️ 两条判据都是**实测**出来的，不是设想的（数字与样本见 `_clickable_of` 的注释）：
#   · `url:` 前缀 148 个键里有 3 个畸形（域名后直接跟中文/半角括号）⇒ 不许当链接；
#   · `wiki:` 前缀 14 个键里 8 个装的是 `obj_token` ⇒ 恒拼 `/wiki/` 必错。
_TOKEN_SHAPE = re.compile(r"^[A-Za-z0-9]{18,30}$")
#: token → **路径段**（`docx`/`wiki`/`file`/`sheets`/`base`）或 `None`（查不到/没权限）。
#: 缓存放在模块级：一次报告里 5 条命中常只对应 2~3 个 token ⇒ 只查这几次。
_link_probe_cache: "dict[str, str | None]" = {}
#: token → 探不到时的**成因**（`permission_denied` / `not_found` / `transient` / `probe_off`）。
#: ★ 为什么单记成因：Owner 报的那批里 **5/14 是 `permission_denied`** ——
#   那是**守衡读不了**，不等于**链接对人无效**。报告里两者必须分开写，
#   否则人会以为「库里这条资源没了」，跑去重建一个其实好好的文件。
_link_probe_states: "dict[str, str]" = {}


def _looks_like_url(u: str) -> bool:
    """这条串**看起来是一条真 URL** 吗（离线判，不打网络）。

    病灶（实测 3 个样本）：`url:http://W1利益点边界表(SWMYUF` —— 旧判据只问
    `startswith("http")`，于是把「域名位置上写着中文表格名、后面还挂着半个括号」的东西
    印成了可点链接。⇒ 收紧成：协议 + **ASCII 主机名** + 至少一个 `/` 或结束。
    """
    s = str(u or "").strip()
    return bool(re.match(r"^https?://[A-Za-z0-9][A-Za-z0-9.-]*(\.[A-Za-z]{2,})?(/|$)", s))


def _probe_wiki_token(tok: str, _probe=None, timeout: int = 6) -> "str | None":
    """`wiki:<token>` 里的 token **到底指向什么对象** ⇒ 回路径段；取不到回 None。

    为什么非查不可：`/wiki/` 只认 `node_token`，而库里这一格**两种都可能装**
    （实测 8 个对象 token / 1 个节点 token）。`wiki +node-get` 对**两种都**解析得出：
      · `node_token == 入参` ⇒ 它是节点 ⇒ 路径段 `wiki`
      · `obj_token  == 入参` ⇒ 它是对象 ⇒ 路径段按 `obj_type`（docx/sheet/bitable/file…）
    取不到（`permission_denied` / 超时 / CLI 不在）⇒ **None**（调用方写「取不到直链」）。

    ⚠️ 这是**只读**调用，身份沿用库内既有约定（`--as bot --profile dsh-kb`）。
    ⚠️ 开关 `KB_LINK_PROBE=0` 可整体关掉（**测试默认关**，自证要离线可跑、结果确定）。
    """
    if tok in _link_probe_cache:
        return _link_probe_cache[tok]
    # ★★ 先看**登记表**（跨进程生效）：它装两类 ——
    #   ① `dead: true` ⇒ 人实测**已失效**（资源侧没了）；
    #   ② `resolve: "<路径段>"` ⇒ **显式解析**：键里是**节点 token**、对象类型人已核过。
    #   为什么需要 ②：这类键**探测不出来**（bot 不在那个 wiki 空间里 ⇒ `permission_denied`），
    #   而它的真实类型就在 L1 里记着（实测 `EsCdw2A7…`：`node_token` 等于它自己、`obj_type=sheet`）
    #   ⇒ 与其让报告印「未核」，不如把**人核过的结论**登记下来（可核、可回源）。
    _ov = _load_dead_links().get(tok)
    if isinstance(_ov, dict):
        if _ov.get("dead"):
            _link_probe_cache[tok] = None
            _link_probe_states[tok] = "dead_link"
            return None
        if _ov.get("resolve"):
            _link_probe_cache[tok] = str(_ov["resolve"])
            _link_probe_states[tok] = "ok"
            return str(_ov["resolve"])
    # ★ 再看不兼容的旧格式（纯字符串值 = 已失效）—— 这一支优先于任何探测：
    #   资源没了的时候探测只会回 `permission_denied`，那会把"已失效"说成"无权"。
    if tok in _load_dead_links():
        _link_probe_cache[tok] = None
        _link_probe_states[tok] = "dead_link"
        return None
    probe = _probe or _probe_wiki_token_real
    meta = None
    try:
        meta = probe(tok, timeout=timeout)
    except Exception:
        meta = None
    path = None
    state = "transient"                      # 探不到时的成因（默认：暂时性/未知）
    if isinstance(meta, dict):
        if meta.get("_probe_error"):
            # 真实现把错误码带回来（`permission_denied` / `not_found` …）
            state = str(meta.get("_probe_error"))
        else:
            obj_type = str(meta.get("obj_type") or "").strip().lower()
            if str(meta.get("node_token") or "") == tok:
                path = "wiki"
            elif str(meta.get("obj_token") or "") == tok:
                path = {"docx": "docx", "sheet": "sheets", "sheets": "sheets",
                        "bitable": "base", "base": "base", "file": "file",
                        "mindnote": "mindnotes", "slides": "slides"}.get(obj_type)
            # 解析得出、但 `obj_type` 不在映射里 ⇒ **不编路径**（宁可说取不到）
            state = "ok" if path else "unmapped_type"
    _link_probe_cache[tok] = path
    _link_probe_states[tok] = state
    return path


def _link_probe_reason(key: str) -> "str | None":
    """`wiki:<tok>` 取不到直链时，**成因**是什么 —— 给报告如实写，不许混成一句。

    三种必须分开（实测都有）：
      · `permission_denied` ⇒ **守衡无权直读**，人可能点得开 ⇒ 写「需人工点开」；
      · `not_found`         ⇒ 节点/对象真的不在 ⇒ 写「库里这条资源的链接已失效」；
      · 其它（超时/CLI 不在/关了探测/类型认不出）⇒ 写「本次没能解析（未核）」——
        **不许**写成前两种里的任何一种（那是把"未测"说成"测过"）。
    """
    rk = str(key or "")
    if not rk.startswith("wiki:"):
        return None
    tok = rk.split(":", 1)[1].strip()
    if not tok:
        return None
    if not _TOKEN_SHAPE.match(tok):
        return "键里的 token 形状不像飞书 token（未当成链接）"
    st = _link_probe_states.get(tok)
    # ★★ 2026-10-09 晚：**成因也要查登记表** —— `_link_probe_states` 只是**进程内**缓存，
    #   人实测失效的登记落在 `kb/l7/registry/dead-links.json`（跨进程）。
    #   病灶（被判据 A19 抓出来的）：`_clickable_of` 会读登记表 ⇒ 新进程里正确回 None，
    #   而这一格没读 ⇒ 报告里还是印「未核，不等于失效」，**同一件事两个口径**。
    if st is None:
        try:
            _ov2 = _load_dead_links().get(tok)
            if isinstance(_ov2, dict) and (_ov2.get("dead") or _ov2.get("key")) \
                    and not _ov2.get("resolve"):
                st = "dead_link"
            elif isinstance(_ov2, str):
                st = "dead_link"
        except Exception:                                    # noqa: BLE001
            pass
    if st == "permission_denied":
        return "**守衡无权直读该资源**（人可能点得开）⇒ 需人工点开核对"
    if st == "not_found":
        return "该节点/对象在飞书侧已不存在 ⇒ **链接已失效**"
    if st in ("dead_link", "invalid_token"):
        # ★★ 2026-10-09 晚（Owner 逐个点开实测）：这一支**不许再说"人可能点得开"**。
        #   实测：5 条里 **4 条点开报「页面不存在」**，只有 1 条能开。
        #   而那 4 条里两条的 L1 是 `anchor_kind=url`（**地址是从飞书原样抓下来的**，
        #   不是本地拼的）⇒ 失效是**资源侧**的事（迁移/删除），不是路径拼错、更不是权限。
        #   报告里继续写"取不到直链"会让人以为"守衡没本事取"，而真相是**那条链接本身就死了**。
        return "**该链接已失效**（资源侧：节点不存在/已迁移，与守衡权限无关）⇒ 需回源重建该引用"
    if st == "probe_off":
        return "本次未解析（探测关闭）"
    if st in ("ok", "unmapped_type"):
        return "解析到了，但对象类型没有对应的链接路径（未拼，避免给出点不开的链接）"
    return "本次没能解析（超时 / CLI 不可用等）—— **未核**，不等于失效"


def _dead_link_registry_path() -> str:
    """人实测失效的链接登记文件（`.json` 不受「python 直写 .md/.sh」那条信封坑影响）。

    路径从**本文件位置**推算：本文件在 `<库根>/kb/l7/review-engine/core/` ⇒ 上溯 4 层是库根。
    （第一版假设有一个 `_kb_root()` —— 它**不存在**，会把登记静默写到错地方。）
    """
    here = os.path.dirname(os.path.abspath(__file__))
    root = os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(here))))
    # 表名从 `dead-links.json` 改成 `link-overrides.json`（2026-10-09 晚）：
    # 它现在装**两类**东西 —— ① 人实测**已失效**的键；② **显式解析**（键里是节点 token、
    # 但对象类型要靠人核过才知道路径的那种）。沿用旧名会让人以为只装死链。
    return os.path.join(root, "kb", "l7", "registry", "link-overrides.json")


def _load_dead_links() -> dict:
    """读登记表（读不到回空 dict —— 缺表是常态，不是错误）。"""
    try:
        with open(_dead_link_registry_path(), encoding="utf-8") as fh:
            d = json.load(fh)
        return d if isinstance(d, dict) else {}
    except Exception:                                        # noqa: BLE001
        return {}


def _mark_dead_link(*keys: str, note: str = "") -> int:
    """把**人实测已失效**的键登记进 `kb/l7/registry/dead-links.json`。回登记条数。

    ★ 为什么需要它（2026-10-09 晚，Owner **逐个点开** 5 条：**4 条打不开**）：
      这类键在报告里继续印成"可点直链"就是**给出一个点不开的链接**，
      比一句「已失效」更坏（后者至少不骗人）。
      ⚠️ 光靠探测**分不出**「无权」与「已失效」：资源没了时 `wiki +node-get` 也只能回
      `permission_denied`（实测就是如此）⇒ 这一支只能靠**人的实测**登记。
    ★ **必须落盘**（第一版只写内存 ⇒ 下一条报告在新进程里又当它"可能有权"，
      等于这个修复没落库 —— 与当天反复出现的「改了但没落库」同一个形状）。
    """
    d = _load_dead_links()
    n = 0
    for key in keys:
        rk = str(key or "")
        tok = rk.split(":", 1)[1].strip() if rk.startswith("wiki:") else ""
        if not tok:
            continue
        d[tok] = {"key": rk, "marked_at": __import__("datetime").datetime.now().astimezone().isoformat(timespec="seconds"),
                  "by": "human-verified", "note": note or "点开报「页面不存在」"}
        _link_probe_cache[tok] = None
        _link_probe_states[tok] = "dead_link"
        n += 1
    if n:
        path = _dead_link_registry_path()
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "w", encoding="utf-8") as fh:
                json.dump(d, fh, ensure_ascii=False, indent=1, sort_keys=True)
        except Exception:                                    # noqa: BLE001
            pass                                             # 落盘失败不该让这一单挂掉
    return n


def _probe_wiki_token_real(tok: str, timeout: int = 6):
    """真去问飞书（只读）。**失败也把成因带回来**（`_probe_error`），不许缩成一句 None。

    ★ 为什么必须带成因（实测 14 个 `wiki:` 键里 **5 个是 `permission_denied`**）：
      那是**守衡无权直读**，**不等于链接对人无效**。报告里写「取不到直链」而不说原因，
      人会以为库里那条资源没了，跑去重建一个其实好好的文件。
    """
    if os.environ.get("KB_LINK_PROBE", "1") == "0":
        return {"_probe_error": "probe_off"}
    lark = os.path.expanduser("~/.dsh/bin/lark-cli")
    if not os.path.exists(lark):
        return {"_probe_error": "cli_missing"}
    # ⚠️ **必须带上 PATH**（`~/.dsh/bin` 排在前）：`lark-cli` 自己要去找 node，
    #   而本进程（层前置 / 引擎）的 PATH 里未必有它 ⇒ 拿不到 JSON、
    #   所有错误被归成「超时/未核」。**这一条是实测出来的，不是设想**：
    #   同一个 `permission_denied`（131006）的令牌，不设 ENV 时报「未核」，
    #   设了 ENV 才如实报「无权」。库内 `kb/l8/drill_links_2levels.py:85` 早就这么做。
    env = dict(os.environ)
    env["PATH"] = os.path.expanduser("~/.dsh/bin") + ":" + env.get("PATH", "")
    try:
        p = subprocess.run([lark, "wiki", "+node-get", "--node-token", tok,
                            "--as", "bot", "--profile", "dsh-kb"],
                           capture_output=True, text=True, encoding="utf-8",
                           errors="replace", timeout=timeout, env=env)
    except Exception:
        return {"_probe_error": "transient"}
    # ⚠️ **失败时 `lark-cli` 把 JSON 写到 stderr**（stdout 是空的、退出码非 0）——
    #   只解析 stdout 会把 `permission_denied` 误归成「超时/未核」。
    #   **实测**：同一个 131006 的令牌，只读 stdout ⇒ 报「未核」；合并两路 ⇒ 如实报「无权」。
    #   库内 `kb/l8/drill_links_2levels.py` 的 `cli()` 就是 `p.stdout + p.stderr`，这里沿用。
    try:
        d = json.loads((p.stdout or "").strip() or (p.stderr or "").strip())
    except Exception:
        return {"_probe_error": "transient"}
    if isinstance(d, dict) and d.get("ok"):
        return d.get("data")
    # 把飞书自己的错误子类原样带出来（`permission_denied` / `not_found` / …）
    err = (d or {}).get("error") or {}
    sub = str(err.get("subtype") or err.get("type") or "").strip()
    low = sub.lower()
    if "permission" in low or "forbidden" in low or "denied" in low:
        return {"_probe_error": "permission_denied"}
    if "not_found" in low or "notfound" in low or "no_such" in low:
        return {"_probe_error": "not_found"}
    return {"_probe_error": sub or "transient"}


def _clickable_of(resource_key, _probe=None):
    """按库内既有 resource_key 构造口径给出**可点地址**（与 hostlib 生成器同一套映射）。

    ★★ 2026-10-09 晚（Owner：「报告中有个检索读数，链接是**无效的**」）——
      `wiki:` 那个前缀**不再无条件拼 `/wiki/`**。实测（bot 凭据逐个查 L1 的 14 个 `wiki:` 键）：

        · **8 个装的是 `obj_token`**（docx / **file** / bitable 都有）⇒ `/wiki/<obj_token>`
          **点开无效**（`/wiki/` 只认 `node_token`）。Owner 报的那条
          `wiki:TqJSduQE3oBM4uxtHhmcrVtGnPg` 就是它：`obj_type=docx`、
          `node_token=DAd6wOcX2iWuWhkZqqlc0AZxncg` ⇒ 正确链接是 `/docx/<obj_token>`。
        · 5 个 `permission_denied` —— **那是权限问题，不是坏链接**（两者不许混报）；
        · **只有 1 个**是真 `node_token`。

      ⇒ 光把 `/wiki/` 换成 `/docx/` 是**错的修法**：`file` / `bitable` 会变成新的失效链接。
        正确路径**取决于 token 指向什么对象**，只有查一次才知道（`wiki +node-get`
        对两种 token **都**解析得出：`obj_token == 入参` ⇒ 是对象；`node_token == 入参` ⇒ 是节点）。
      ⇒ 取不到就**返回 None**（卡/报告如实写「取不到直链」）——**绝不回落到一个点不开的链接**：
        一个点不开的链接比一句「取不到」更坏（后者至少不骗人）。

      ⚠️ **改了这一条不等于放宽**：`url:`/裸 http 那两路一个字没动，只多一条**形状校验**
        （畸形的 `url:` 值原先会被当链接印出去，实测 148 个里有 3 个）。
    """
    if not resource_key:
        return None
    rk = str(resource_key)
    if rk.startswith(("http://", "https://")):
        return rk
    # ★★ 2026-10-09：`url:` 前缀 —— **键里本来就嵌着一条真 URL**，原先被整条丢掉。
    #   实测（展会物料那一单，2/5 条命中拿不到链接）：L1 里这类资源的 `resource_key` 是
    #   `url:https://momcozy-in.feishu.cn/wiki/Zqz7w1W9ZiP7i8kXNTGc9cBGnVb`，
    #   而下面那个循环只认 wiki/docx/sheets/base/file 五个前缀 ⇒ 一个都不匹配
    #   ⇒ 落到最后一行 `rk.startswith("http")`（`url:` 开头，**为假**）⇒ 返回 None
    #   ⇒ 卡上写「取不到直链」，**而那条链接就在手里**。
    #   Owner 要的是「命中原文 **+ 飞书链接**」——手里有链接却说没有，是最没道理的一种缺。
    if rk.startswith("url:"):
        u = rk.split(":", 1)[1].strip()
        # ★ 形状校验（2026-10-09 晚）：`url:http://W1利益点边界表(SWMYUF` 这种**不是 URL**
        #   ——域名后面直接跟中文与半个括号。旧判据 `startswith("http")` 会把它印成链接。
        return u if _looks_like_url(u) else None
    tok = rk.split(":", 1)[1] if ":" in rk else ""
    if not tok:
        return rk if rk.startswith("http") else None
    # ★ 形状校验：Feishu 的 token 是定长 base64url（实测 22~27 位、纯 `[A-Za-z0-9]`）。
    #   形状不对（如测试用的 `Tok123`、含中文的）⇒ **不拼链接**（宁缺勿假）。
    if not _TOKEN_SHAPE.match(tok):
        return None
    if rk.startswith("wiki:"):
        # 唯一需要**查一次**才能定路径的一类：键里的 token 可能是节点、也可能是对象。
        path = _probe_wiki_token(tok, _probe=_probe)
        return "https://momcozy-in.feishu.cn/%s/%s" % (path, tok) if path else None
    for pre, path in (("docx:", "docx"), ("sheets:", "sheets"),
                      ("base:", "base"), ("file:", "file")):
        if rk.startswith(pre):
            return "https://momcozy-in.feishu.cn/%s/%s" % (path, tok)
    return rk if rk.startswith("http") else None


_L0REC_URL = None


def _l0_record_urls():
    """record_id → **记录级** L0 直链（`entry_url`，带 `&record=…`）。缓存在模块里，只建一次。

    ★ 2026-10-09 加。病灶（实测，不是推演）：有一整类命中**拿不到直链** ——
      `kb/l6/index/l6.jsonl` 的行**没有** `l0_entry_url`（只有 anchor / kb_type / unit_id），
      而回落的 `_clickable_of(resource_key)` **认不得 `bitable:` 这种键**
      （它只认 wiki/docx/sheets/base/file 五个前缀），
      那些键形如 `bitable:Lk3Qb8y2QaVyZns6gprcVNE9nA0:recvuNifmKBXoP` ⇒ 返回 None
      ⇒ 卡上只能写「取不到直链」。而同一批单元在 L0 **是有记录级直链的**。
      Owner 要的是「命中原文 **+ 飞书链接**」——**一半命中没链接就不算做到**。
      ⇒ 从 L0 记录（`kb/l0/records/<源表>/<record_id>.json`）建一张 `record_id → entry_url`。
    """
    global _L0REC_URL
    if _L0REC_URL is None:
        m = {}
        try:
            import glob as _g
            for p in _g.glob(os.path.join(ROOT, "kb", "l0", "records", "*", "*.json")):
                try:
                    d = json.load(open(p, encoding="utf-8"))
                except Exception:         # noqa: BLE001
                    continue
                rid = d.get("record_id") or os.path.basename(p)[:-5]
                u = d.get("entry_url")
                if rid and u:
                    m[str(rid)] = u
        except Exception:                 # noqa: BLE001
            pass
        _L0REC_URL = m
    return _L0REC_URL


def _hit_link(h, rid, rid2key=None):
    """一条命中的**可点直链** —— 三级回落，取到就返回，取不到**返回 None（不编）**。

    ★ 抽出来是为了**一处口径**：`kb_hits_of()`（机读，给守衡）与 `render_kb_hits()`
      （文本，给摘要）都要它。原先两处各写一遍 —— 而这个库里「同一个东西两个产出者、
      只修了一个」已经栽过多次。
    ① `l0_entry_url`（命中行自带，最准）
    ② `resource_key → _clickable_of()`（wiki/docx/sheets/base/file）
    ③ **L0 记录级 `entry_url`**（`bitable:` 那类键走这里 —— ①②都取不到时）
    """
    if not isinstance(h, dict):
        return None
    u = h.get("l0_entry_url")
    if u:
        return u
    # ★★ 先用手上**记录的链接**（L1 的 `source.url`/`entry_url`）—— 它零成本、零权限依赖，
    #   而 token 解析要 bot 有权限（实测 5/5 `permission_denied` ⇒ 解析不出来）。
    #   顺序反了就会出现「手里有链接，报告却写未核」。
    if rid:
        u0 = _rid_to_url().get(rid)
        if u0:
            return u0
    u = _clickable_of((rid2key or _rid_to_key()).get(rid) if rid else None)
    if u:
        return u
    rec = str(rid).rsplit("__", 1)[-1] if rid else ""
    return _l0_record_urls().get(rec) if rec else None


def kb_hits_of(hits, limit=8):
    """把检索命中收成**机读**的 `kb_hits`（给下游渲染用；`render_kb_hits` 是给人看的文本版）。

    ★ 2026-10-09 从 `run()` 里那段内联代码抽出来。抽出来的**唯一理由**：
      原先它只写在「覆盖缺口」那一条支路里 ⇒ **库真命中的正常单子拿不到 `kb_hits`**，
      而 Owner 要的是「**所有**视频都带命中原文+飞书链接」。一份口径、三条支路共用。

    字段（缺的**不编**，如实为 None）：
      anchor / bm25 / kb_type / source_sha256 / excerpt（截 200 字）/ url（L0 可点直链）
    `url` 的来路见 `_hit_link()`（三级回落）。
    """
    out = []
    try:
        u2rid = _unit_to_rid()
        rid2key = _rid_to_key()
        for h in (hits or [])[:limit]:
            if not isinstance(h, dict):
                continue
            t = (h.get("excerpt") or h.get("text_excerpt") or h.get("text") or "").strip()
            if not t:
                continue
            r = h.get("resource_id") or u2rid.get(h.get("unit_id"))
            out.append({
                "anchor": h.get("anchor"),
                "bm25": h.get("raw_bm25", h.get("bm25", h.get("score"))),
                "kb_type": h.get("kb_type"),
                "source_sha256": h.get("source_sha256"),
                "excerpt": " ".join(t.split())[:200],
                "url": _hit_link(h, r, rid2key),
            })
    except Exception:                     # noqa: BLE001
        return []
    return out


def md_text_safe(s):
    """把**库内原文**变成可以安全嵌进 markdown 的字面文本。

    ★★ 2026-10-09（Owner：「图片/视频现在是合并报告吗？」查出来的真因）──────────
    病灶：库内记录的 `excerpt` **含原始 HTML**（实测那条视频单的命中原文是
    `<table><colgroup>…` 与 `>修改字幕</li></ol><img name="image.png" alt="…">`）。
    这些串被**逐字**印进报告 markdown 后，飞书 `docs +create` 会**把它当 HTML 解析**：
        invalid <img> local resource tag: XML syntax error on line 1:
        invalid character entity &#39 (no semicolon)
    ⇒ **整份文档发不出去**（不是那一行坏，是整份拒绝）。

    为什么"发文案对、发图/视频不对"：文案单的命中文案是纯文本（不含 `<`），
    而图/视频单命中内部样本库的**富文本** ⇒ 必撞。

    最小复现与修法都已实测（2026-10-09）：
      · 那份 12,877 字节的真实报告原样发 ⇒ `ok:false`（上面那个错）；
      · **只**把「命中原文」行的 `<` `>` 换成 `&lt;` `&gt;` ⇒ `ok:true`。

    只转义这两个字符（不动 `&`）—— `&#39` 那种坏实体**本身就是从 `<`/`>` 的解析路径
    进来的**，把标签起点掐掉，解析器就不会去解它内部的实体了。

    ★★ 2026-10-09 补：**`~` 也要转义**（Owner 报告里看到「~~」）。
      实测（图单报告）：库内原文里带 `~~…~~`（那是**库里某人的批注痕迹**），
      印进 markdown 后飞书把 `~~…~~` 渲染成**删除线** ⇒ 「**依据**：」那一行被划掉、
      字段名与内容糊在一起（报告里印成 `~~**~~依据~~**~~：…`）。
      `~` 在正常报告里**不承担任何 markdown 作用**（我们不用删除线），
      所以转义它没有副作用；不转义则**原文的观感被改**，读者会以为那段是被删掉的东西。
    """
    return (str(s if s is not None else "")
            .replace("<", "&lt;").replace(">", "&gt;")
            .replace("~", "&#126;"))


def render_kb_hits(hits, limit=8):
    """把检索命中渲染成「库内命中（读数）」一节。字段**防御式**取（不同来源键名不一）。"""
    rows = []
    m = _rid_to_key()
    for i, h in enumerate((hits or [])[:limit], 1):
        if not isinstance(h, dict):
            continue
        txt = (h.get("excerpt") or h.get("text_excerpt") or h.get("text") or "").strip()
        if not txt:
            continue
        bm = h.get("raw_bm25", h.get("bm25", h.get("score")))
        # 命中行里通常**没有** resource_id（实测），但有 unit_id ⇒ 经 L2 反查
        rid = h.get("resource_id") or _unit_to_rid().get(h.get("unit_id"))
        url = _hit_link(h, rid, m)      # ★ 与 `kb_hits_of()` 同一套口径（三级回落，见 `_hit_link`）
        # ★ 取不到时**把成因写出来**（2026-10-09 晚）：`permission_denied`（守衡无权直读，
        #   人可能点得开）与「链接已失效」是两件事，混成一句会让人去重建一个好好的文件。
        if not url:
            _rk = (m or {}).get(rid) if rid else None
            url = "**取不到直链**" + ("（%s）" % _link_probe_reason(_rk) if _link_probe_reason(_rk)
                                      else "（该命中的锚点不是记录级、且资源键为空）")
        # ★ `md_text_safe`：命中原文是**库内原文**，可能含原始 HTML（见其 docstring）
        anchor_safe = md_text_safe(h.get("anchor") or "(无锚点)")
        rows.append(
            "%d. `%s`｜BM25 %s｜%s\n   命中原文（逐字）：%s\n   直链：%s"
            % (i, anchor_safe.replace("`", "'"), bm,
               md_text_safe(h.get("kb_type") or "未标类型"),
               md_text_safe(" ".join(txt.split())[:160]),
               url))
    if not rows:
        return ""
    return ("\n\n**库内命中（读数）** —— 检索命中了 %d 条，逐条列出**原文与直链**：\n\n"
            % len(rows) + "\n".join(rows) +
            "\n\n> ⚠️ 上面是**读数**：命中的**大多是别人的素材样本 / 外部材料，不是覆盖本素材的条款**，"
            "**不得据此当 PASS 依据**，也不得当作「本素材已合规」的证明。")


def _evidence_findings(text: str, write_report: bool = False,
                       findings_from=None, findings_out=None, scene=None, content_type=None,
                       position=None):
    """拿依据侧（kb-content-review 的 review.py）带条款号的 findings。

    三条路：
      * `--findings-from`：读缓存 —— **不** subprocess 跑 review.py（同一 RUN 的第二处消费者走这条）；
      * `--findings-out`：跑完之后把依据落成中间产物，供第二处消费者复用；
      * 都不给：原行为（每次现跑）。

    现跑时取 stdout 里最后一个 JSON 对象 —— 它前面会打印 `[review] 落盘通道…` / `[fix] 条款号…` 这类日志行。
    """
    if findings_from:
        return _read_findings_cache(findings_from, text)
    if not REVIEW_PY.exists():
        return None, "依据组件不在位：%s" % REVIEW_PY
    cmd = [sys.executable, str(REVIEW_PY), "--kb-root", str(ROOT), "--text", text, "--json"]
    # ★★ 2026-10-20（实测缺陷，最坏的一类）：**适配器从不把 content-type 传给依据层**。
    #   实测：一张图（守衡送来的正文 = OCR + 画面读数）走 `with_kb_evidence` ⇒ 依据层收到的是默认
    #   `text` ⇒ 「负面样本规则 N-1.x」层**根本没跑** ⇒ 0 条、结论 PASS。
    #   而同一段正文直调 review.py 时是 5 条 REVIEW。**差别只在这一行。**
    #   归一化：守衡传的是中文「图片/视频」，review.py 只认 text/image/video。
    _ct = str(content_type or "").strip().lower()
    _ct = {"图片": "image", "image": "image", "视频": "video", "video": "video"}.get(_ct, "text")
    if _ct != "text":
        cmd += ["--content-type", _ct]
    # ★ 2026-10-20：把**画面读数**透传给依据层（负面样本规则 N-1.x 层靠它才启得起来）。
    #   传的是守衡 scene.mjs 的输出本体；落成临时 JSON，review.py 侧 --scene-json 读它。
    if scene is not None:
        import tempfile as _tf
        _sf = os.path.join(_tf.mkdtemp(prefix="kb-scene-"), "scene.json")
        with open(_sf, "w", encoding="utf-8") as _fh:
            json.dump(scene, _fh, ensure_ascii=False)
        cmd += ["--scene-json", _sf]
    # ★★ 2026-10-20（Owner 令「位置要写尽详细具体位置」）：把**复核人写的位置**透传给依据层。
    #   病根：不给 `--position` 时 review.py 用 image 的默认 `图片 1（#img.1）`，
    #   归一化后成了裸 `图 1` —— 出口闸 R3 正是点名这个形状判红。
    #   不给本参数 ⇒ 行为与改动前**逐字一致**（仍是 review.py 的那个默认）。
    if position:
        cmd += ["--position", str(position)]
    if not write_report:
        cmd.append("--dry-run")          # 默认不落盘（冒烟/预演）；要留痕就 write_report=True
    # ★ 防线1（2026-10-03）：把「从哪扇门进来的」告诉 review.py —— 它自本批起**拒直接调用**。
    #   背景：能出结论的入口原有两扇（本文件 vs review.py 直调），而闸门只装在本文件上；
    #   实测 10:04 那条外来会话直调 review.py ⇒ `evidence_meta` 空、无层前置、无发布、无 <run>.review.md。
    r = subprocess.run(cmd, capture_output=True, text=True,
                       env=dict(os.environ, KB_INTERP_OK="1", KB_ENTRY="with_kb_evidence"),
                       timeout=600)
    out = r.stdout or ""
    ev = None
    i = out.find("{")
    while i != -1:
        try:
            ev = json.loads(out[i:])
            break
        except json.JSONDecodeError:
            i = out.find("{", i + 1)
    if ev is None:
        return None, "依据组件没吐出 JSON（rc=%d）：%s" % (r.returncode, (r.stderr or out)[-200:])
    ev["_findings_source"] = {"mode": "live", "path": str(REVIEW_PY)}
    if findings_out:
        try:
            _write_findings_cache(findings_out, text, ev)
        except OSError as e:              # 缓存写不了不该让评审失败
            print("[warn] findings 缓存没写成：%r" % (e,), file=sys.stderr)
    return ev, None


def _desc_of(f):
    """**问题描述**（PRD §8.3 六格之一）—— 必须有，且 ≤50 字（PRD §5.3.3）。

    ★★ 2026-10-20（Owner：「问题描述：（本条未提供问题描述）==》不允许出现这样的回答，
      必须有问题描述」）：本函数**新增** `description` 这一格。改前 `_to_risk_item` 压根没有它
      ⇒ 渲染层（守衡 `descriptionOf()`）取不到 ⇒ 报告逐条印占位句
      `（本条未提供问题描述）`，收报告的人看不出这条到底哪里有问题。

    取值三条，**都不编**：
      ① 条目自带 `description`（案例层已按「库内反例 + 问题要点」写好）；
      ② 没有描述但有逐字命中 ⇒ 用命中原文，并**明说这是替代**（它不是模型写的描述）；
      ③ 都没有 ⇒ 用「库内条款命中（规则码/类别）」如实交代 —— 仍不是空，也不是占位句。
    """
    d = str(f.get("description") or "").strip()
    if d:
        return d[:50]
    exc = str(f.get("excerpt") or "").strip()
    if exc:
        return ("逐字命中「%s」（以命中原文代描述）" % exc)[:50]
    tail = str(f.get("rule_code") or f.get("category") or "未分类").strip()
    # ★ 2026-10-20：负面样本规则的命中带**证据类**（figure/record/shared）——
    #   把它压成短标签放进描述，卡片与报告才看得出「这条意见凭什么算」，
    #   而不是把复用图的记录级意见当成"这张图的问题"（那正是串图）。
    _cls = str(f.get("evidence_class") or "").strip()
    _tag = {"figure": "按图号对上本图", "record": "记录级意见",
            "shared": "复用图·同图历史意见"}.get(_cls, "")
    _base = "库内条款命中（%s）" % tail
    return ((_base + "·" + _tag) if _tag else _base)[:50]


def _to_risk_item(f):
    """依据 → 契约 risk_items 的一条（字段名按 review-contract.json + review_engine 的实际判据对齐）。

    两个实测坑（2026-09-30，第一次跑判成 NEEDS_INPUT 就是它们）：
      * `coverage` 的取值必须是 `"complete"` / `"not_applicable"`（不是布尔）—— `_coverage_ready()` 只认这两个字面量；
      * `evidence_complete` 的判据是 `bool(location and (evidence_url or evidence_id))`，
        **比引用契约弱得多**（它不核对 anchor/sha256 是否解析得到）。
        所以这里**只在引用契约六要素齐了才写 evidence_id** —— 让引擎那个弱判据背后站着强判据；
        要素不齐的条目故意不给 evidence_id，引擎就会把它归进 REVIEW（而不是放它进 BLOCK）。
    """
    lib, art = f.get("library"), f.get("article_no")
    anc, sha, exc = f.get("anchor"), f.get("source_sha256"), f.get("excerpt")
    complete = all([lib, art, anc, sha, exc])
    # ★★ 2026-10-09（第九批）：**两种链接来源都认** —— 这一行才是「图片有链接、文案没有」
    #   的真正根因层（依据层只是表现形式之一）。
    #   病灶：本函数原先只读 `f["l0_entry_url"]`。而依据侧（`review.py`）产链接有**两条合法路**：
    #     ① 直接给 `l0_entry_url`（案例层 / 规则层「不可逐字回源」/ P0「不可逐字回源」都走这条）；
    #     ② 给 `verbatim_source = {path, field, entry_url}`（**规则层主路**与 P0 确定性匹配走这条）。
    #   第 ② 条本函数**完全不看** ⇒ `evidence.l0_entry_url` 恒为 None ⇒
    #   `evidence_url` 退回本地路径 `kb/l3/candidates/rules.jsonl#W-x.y` ⇒ **卡片上没有飞书链接**。
    #   而**同一份 finding 的报告**（`review.py:1285`）自己回落读了 `verbatim_source.entry_url`
    #   ⇒ 于是出现「**报告里有直链、卡片里没有**」这种最难看懂的分裂。
    #   实测（2026-10-09，Owner 报「图片输出的依据带飞书链接了，怎么文案输出依据没带飞书链接呢？」）：
    #   图片走**案例层**（路 ①，一直好），文案走**规则层主路**（路 ②，一直丢）——
    #   两条路**只差这一处读没读**，跟图片/文案本身无关。
    #   ⇒ 口径：**谁是合法来源，谁就得被认**（库规「不给直链等于没法定回去」）。
    #     取不到仍留 None（**不编**），`evidence_source` 照实写明是哪一种 —— 不静默换源。
    _l0u = (f.get("l0_entry_url")
            or (f.get("verbatim_source") or {}).get("entry_url") or None)
    cat, sub = f.get("category") or "未分类", f.get("sub") or ""
    # ── P0–P3 分级（2026-10-10 接线 · 任务拆解 目标12 · PRD §6.2/§6.3）────────────
    # 改前：`"P0" if "P0" in str(f.get("layer") or "") else "P1"`。
    #   两个后果，都实测过：
    #   ① `f` 是依据层的 finding，**它没有 `layer` 键** ⇒ 恒为 `P1`（P0 也报 P1）；
    #   ② 即便有 layer，判据也是**看文案里有没有「P0」二字**，不是规则的 `p_level`
    #      ⇒ `p_level=P2` 的 11 条 / `p_level=P3` 的 4 条规则命中了也只报 P1，
    #        PRD §6.3 第二/第三层等于没实现（PRD §7.2 九域里 7 个域挂 P1/P2 ⇒ 判不了）。
    # 现在走 `core/tiering.py` 的**单一口径**：先读 `p_level`（主路），
    # 再退 `layer` 文案 / 层类型 / severity，**都不给才 P1 兜底且依据写明是兜底**。
    _tier, _tier_basis = tiering.tier_of(
        p_level=f.get("p_level"), layer=f.get("layer"),
        severity=f.get("severity"), risk_level=f.get("risk_level"))
    item = {
        "risk_id": f.get("rule_id"),
        "risk_type": ("%s-%s" % (cat, sub)) if sub else cat,
        # ★★ 2026-10-12（任务拆解 10/19–10/23 必须做 #1 · PRD §5.3 / §8.3 / §5.4）：
        #   问题**维度**。PRD §5.4 的 JSON 规范逐字同时给两格 —— `"risk_type": "合规-医疗宣称"`
        #   与 `"risk_category": "合规"` —— 而**后者此前全库 0 命中**（`grep` 过 `kb/l3..l7`）。
        #   本格由 `review.py`（返回前统一盖章）算出，口径是
        #   `kb/l7/registry/risk-category-policy.json`（唯一一份）。
        #   **未映射的类别留 `None`，不蒙维度** —— 出处见同级的 `risk_category_basis`。
        "risk_category": f.get("risk_category"),
        "risk_category_basis": f.get("risk_category_basis"),
        # ★★ 2026-10-17（Owner：「既然分了11类，就要按照11类的出结果」）：
        #   **11 类 / 58 子类**（附加视图）。上面两格是 PRD §5.3 四维、`risk_type` 是库内 8 类词表，
        #   三格并存、互不顶替；本格只用于「按 11 类」的附加汇总与报告分组。
        #   由 `review.py::stamp_taxonomy()` 逐条盖章（真源 `kb/l3/registry/rule-taxonomy.json`，
        #   **人工口径 / Owner 采用，不是源表字段**）；盖不到就是 None + basis 写明原因，**不编**。
        "taxonomy_category": f.get("taxonomy_category"),
        "taxonomy_subcategory": f.get("taxonomy_subcategory"),
        "taxonomy_basis": f.get("taxonomy_basis"),
        "priority_tier": _tier,
        "priority_tier_basis": _tier_basis,
        "p_level": f.get("p_level"),
        "status": "confirmed",
        # ★ action 仍按 severity 定，**这一步不改判据**：
        #   tiering 的 `action_of()` 是「该层级通常该给什么动作」的政策表；
        #   而这里要保留依据层**逐条**判出的严重度（P0 命中即 BLOCK 那条硬约束靠它）。
        #   两者混用会把「层级」和「这一条判了什么」搅在一起 —— 分开存，各自可核。
        "tier_action": tiering.action_of(_tier),
        "action": "block" if str(f.get("severity")).upper() == "BLOCK" else "review",
        "location": f.get("position") or "全文",
        # ★★ 2026-10-20（Owner：「不允许出现这样的回答，必须有问题描述」）：PRD §8.3 六格之一。
        #   守衡 `descriptionOf()` 的取值顺序是 `x.description → x.kb.description → excerpt → 占位句`
        #   ⇒ 这一格不给，报告就只能印「（本条未提供问题描述）」。
        "description": _desc_of(f),
        "original_text": exc or "",
        "reason": f.get("reason") or "",
        "suggestion": f.get("advice") if f.get("advice") not in (None, "None") else (f.get("advice_note") or ""),
        "rule_code": f.get("rule_code"),
        # ★★ 2026-10-14（Owner：「所有参考知识库的，都必须带飞书侧源链接」）：
        #   **把库自己的「不权威」声明搬进 risk_items**。`scan_text()` 产的非权威候选带着
        #   `authoritative: false` / `authority` / `superseded_by`（种子规则自己写着
        #   「这不是知识库的规则真源」），而这三格**在被搬进 risk_items 的那一步就丢了**
        #   ⇒ 下游（守衡卡片 / 报告）拿不到 ⇒ 候选被贴成「**有库内条款依据**」、
        #     与真依据长得一模一样（实测那张 hospital-grade 卡：候选那条印成
        #     `**有库内条款依据**` ＋ `《知识库》（未给条款号）`）。
        #   ⚠️ 这不是「多给一个字段」：判据 `review_engine.is_candidate()` 认的就是
        #      **显式 `authoritative is False`**（缺键 = 真依据）⇒ 搬出去下游才判得准。
        "authoritative": f.get("authoritative"),
        "authority": f.get("authority"),
        "superseded_by": f.get("superseded_by"),
        "fact_or_inference": f.get("fact_or_inference"),
        "confidence": f.get("confidence"),
        # ★★ 2026-10-08（第三批）：**L0 飞书直链要跟着搬出去**。
        #   依据侧（`review.py`）早就产了它（`l0_entry_url = _l0_entry_url(anchor)`，
        #   库规原话：「要真核对只能点飞书直链」「不给直链等于没法定回去」），
        #   但本函数原先只搬 library/article_no/anchor/source_sha256/excerpt 五格
        #   ⇒ **直链在被搬进 risk_items 的那一步被丢掉了**，下游（报告 / 飞书 / 守衡卡片）
        #   谁都拿不到。实测（2026-10-08，床照那张图）：命中文字、条款号 S-1.267、锚点、sha 都有，
        #   **唯独没有可点开的源链接** —— 而委托方要的依据正是「命中文字 + 飞书源链接」。
        "evidence": {"library": lib, "article_no": art, "anchor": anc,
                     "source_sha256": sha, "excerpt": exc,
                     "l0_entry_url": _l0u},
        "source": "kb-content-review",
    }
    if complete:
        item["evidence_id"] = "《%s v0》第 %s 条 @ %s @ %s" % (lib, art, anc, str(sha)[:12])
        # ★ 2026-10-08：**来源链接优先给飞书直链**。
        #   原先是写死的 `kb/l3/candidates/rules.jsonl#<条款号>` —— 一个**本地路径**：
        #     ① 人点不开；② 案例类依据（L4 定稿反例条款）根本不来自 rules.jsonl ⇒ **指向错文件**。
        #   现在：有直链（`l0_entry_url` 或 `verbatim_source.entry_url`，见函数顶部的 `_l0u`）
        #   就用它；没有才退回原来的本地路径
        #   （**不静默换源**：`evidence_source` 如实写明这一格是哪一种）。
        item["evidence_url"] = _l0u or ("kb/l3/candidates/rules.jsonl#%s" % art)
        item["evidence_source"] = "L0 源记录直链（飞书）" if _l0u else "本地候选件（无 L0 直链）"
    else:
        item["evidence_gap"] = "引用契约六要素不全（缺 %s）" % ",".join(
            k for k, v in (("库名", lib), ("条款号", art), ("anchor", anc),
                           ("source_sha256", sha), ("逐字摘录", exc)) if not v)
    return item


def _coverage_for(content_type: str, provided=None) -> dict:
    """按**声明的模态**推覆盖率。★ 2026-10-05 加，取代原先写死的那一份。

    规则（只有三条，别扩张）：
      1. 送审的文本总是 complete —— 它是本次审查的实际输入；
      2. `content_type` 声明的模态，只有**拿到了 provider 佐证**（`provided` 里显式给了
         `provider/provider_version/content_hash/status`）才算 complete；
         否则一律 `incomplete` —— 那是**缺口**，不是"不适用"（KB 自己 confirmed_by_user 的口径：
         *Do not emit PASS until a URL or file is actually readable and required modality
         coverage is complete.*）；
      3. 其余模态才写 `not_applicable`。
    """
    provided = provided or {}
    cov = {"text": "complete", "image": "not_applicable", "audio": "not_applicable",
           "video": "not_applicable", "ocr": "not_applicable",
           "asr": "not_applicable", "keyframes": "not_applicable"}
    need = {"image": ("image", "ocr"), "video": ("video", "audio", "ocr", "asr", "keyframes")}.get(
        (content_type or "text").strip().lower(), ())
    for m in need:
        got = provided.get(m) or {}
        ok = all(got.get(k) for k in ("provider", "provider_version", "content_hash", "status"))
        cov[m] = "complete" if ok else "incomplete"
    cov["note"] = ("声明模态：%s；未拿到 provider 佐证的模态记 incomplete（缺口，不是不适用）"
                   % (content_type or "text"))
    # ★ 2026-10-05 加（用户裁定）：调用方可以**申报** provider 佐证（CLI `--coverage`）。
    #   那与 `--loaded-skill` **同级** —— 是**申报**，不是引擎自测。**不许静默**：
    #   申报过的模态在这里逐个点名，结论里永远看得见「这份 complete 是谁说的」。
    if provided:
        cov["declared_by"] = "caller"
        cov["declared_modalities"] = sorted(provided)
        # ★ 2026-10-20 加：**逐个点名是谁在作证、怎么来的**。
        #   这一格只加留痕，**不参与判定**（判定仍是上面那条 ok=四段齐全）。
        cov["declared_providers"] = {m: (provided.get(m) or {}).get("provider")
                                     for m in sorted(provided)}
        cov["declared_via"] = {m: (provided.get(m) or {}).get("via")
                               for m in sorted(provided)}
        cov["note"] += ("；其中 %s 的「complete」来自**调用方申报**（不是引擎自测），按申报档看待"
                        % "、".join(sorted(provided)))
    return cov


def _parse_coverage_specs(specs):
    """把 CLI 的 `--coverage 模态:provider:版本:内容hash:状态` 解析成 `_coverage_for` 认的 dict。

    只做**形状**校验，**不判断真假** —— 真假由调用方负责（这是申报档）。
    形状不对就抛错、由调用方**报错退出**：静默忽略会让人误以为申报生效了。
    """
    out = {}
    for s in specs or []:
        parts = str(s).split(":")
        if len(parts) != 5:
            raise ValueError("需要 5 段（模态:provider:provider_version:content_hash:status），收到 %r" % s)
        m, provider, ver, chash, status = (p.strip() for p in parts)
        if not (m and provider and ver and chash and status):
            raise ValueError("有一段是空的：%r" % s)
        # `via` 只用于**留痕**（结论里看得出这份 complete 是手填的、还是登记件换来的），
        # 不参与判定；`_coverage_for()` 只认四段佐证在不在。
        out[m] = {"provider": provider, "provider_version": ver,
                  "content_hash": chash, "status": status,
                  "via": "cli--coverage"}
    return out or None


#: 已登记的多模态 provider —— **唯一真源**，由 `_coverage_from_images()` 实读。
#: 为什么要登记（2026-10-20 真单）：`--coverage` 要手填四段、其中 content_hash 是文件 sha256，
#: 手抄必然抄错或漏抄 ⇒「agent 自己看过图」没有任何机器可核的落点 ⇒ 引擎只能回 NEEDS_INPUT
#: （`incomplete_coverage:image,ocr`），**与图片内容无关**。
VISION_PROVIDERS_PATH = KB / "l7/review-engine/knowledge-base/vision-providers.json"


def load_vision_providers(path=None):
    """读已登记的 provider 清单 → {id: spec}。

    读不到 / 不是合法 JSON / 缺 `providers[]` ⇒ **抛 ValueError**（不静默返回空）：
    静默返回空会让「申报没生效」看起来和「没申报」一模一样。
    """
    p = Path(path) if path else VISION_PROVIDERS_PATH
    try:
        raw = json.loads(p.read_text(encoding="utf-8"))
    except OSError as e:
        raise ValueError("读不到 provider 登记件 %s：%s" % (p, e))
    except json.JSONDecodeError as e:
        raise ValueError("provider 登记件不是合法 JSON %s：%s" % (p, e))
    items = (raw or {}).get("providers")
    if not isinstance(items, list) or not items:
        raise ValueError("provider 登记件缺 providers[]：%s" % p)
    out = {}
    for it in items:
        pid = (it or {}).get("id")
        if not pid:
            continue
        out[pid] = it
    if not out:
        raise ValueError("provider 登记件里没有任何带 id 的条目：%s" % p)
    return out


def _sha256_file(path):
    """**实算**文件 sha256 —— 这就是 `--image` 存在的理由（手抄 sha 必然抄错）。"""
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def _coverage_from_images(paths, provider_id="agent-inline-vision",
                          provider_version=None, providers=None):
    """把「调用方真读过这几张图」转成 `_coverage_for()` 认的 provided 结构。

    与 `--coverage` **同级**：都是**申报**，不是引擎自测。差别只在**谁填 content_hash**：
    这里由本函数**实算文件 sha256**（手抄正是 2026-10-20 那次「看了图但填不出证据」的来源）。

    ⚠️ 只适用于**完整读过**的图：本开关一律记 `status=complete`。
      读不全（遮挡 / 太小 / 只看局部）**不许用本开关** —— 当前判据**不分辨** `status` 的取值
      （见登记件 `kb/l7/registry/report-output-contract.yaml`
      → `known_defect_20261020_coverage_status_unchecked`），
      用了就会把「没读全」伪装成「读全了」。

    content_hash 形状（稳定、可复现）：
      · 单图 ⇒ 该文件 sha256（人与机器对得上）；
      · 多图 ⇒ 各图 sha256 **排序后拼接**再 sha256（与传入顺序无关）。
    """
    paths = [str(x) for x in (paths or [])]
    if not paths:
        return None
    providers = providers if providers is not None else load_vision_providers()
    spec = providers.get(provider_id)
    if spec is None:
        raise ValueError("provider %r 没有登记（已登记：%s）"
                         % (provider_id, "、".join(sorted(providers)) or "无"))
    mods = spec.get("modalities") or []
    if not mods:
        raise ValueError("provider %r 没声明 modalities，不知道它能给哪些模态作证" % provider_id)
    ver = provider_version or spec.get("default_provider_version")
    if not ver:
        raise ValueError("provider %r 没有 provider_version（登记件也没给 default_provider_version）"
                         % provider_id)
    per = []
    for x in paths:
        pp = Path(x)
        if not pp.is_file():
            raise ValueError("图读不到（--image 只收真实文件）：%s" % x)
        per.append({"path": str(pp), "sha256": _sha256_file(pp)})
    if len(per) == 1:
        chash = per[0]["sha256"]
    else:
        h = hashlib.sha256()
        for s in sorted(p["sha256"] for p in per):
            h.update(s.encode("ascii"))
        chash = h.hexdigest()
    out = {}
    for m in mods:
        out[m] = {"provider": provider_id, "provider_version": str(ver),
                  "content_hash": chash, "status": "complete",
                  "via": "registry:%s" % provider_id,
                  "images": [p["path"] for p in per]}
    return out


