        _refusal = ev.get("refusal") or {"state": "NEEDS_INPUT",
                                         "detail": "依据侧拒答（fail-closed）",
                                         "fails_closed": True}
        # ★ 2026-10-05 加（Owner 裁定「建议1：把 NEEDS_INPUT 的原因码带出来，别再只给一个词」）：
        #   原先这里原样只有一句「依据侧拒答（fail-closed）」—— 读起来像"系统坏了"，
        #   而**最常见的一类**其实很具体：**检索命中了、但那条单元没被任何规则引用 ⇒ 覆盖判据不成立**。
        #   实测（图片单，OCR 文本与库内单元逐字相同）：BM25 194.06（门限 16.0，12 倍）、
        #   Top3 全是该图自己的单元，却因为 `rule_cited_unit_hits = []` 而 covered=false ⇒ 拒答。
        #   这些字段**依据侧早就算好了**（`trace.coverage` / `trace.units`），只是没往外传 ——
        #   本段**只做搬运与陈述，不参与判定**：结论仍是 NEEDS_INPUT，一个字不改。
        _ev_trace = ev.get("trace") if isinstance(ev.get("trace"), dict) else {}
        _ev_units = (_ev_trace.get("units") or {}) if isinstance(_ev_trace.get("units"), dict) else {}
        _top = ((_ev_units.get("top_bm25") or [{}])[0] or {})
