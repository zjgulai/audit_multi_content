        else:
            print("结论：NEEDS_INPUT（**层前置缺失** —— 不出三态结论）")
            print("  没给 --require-layer-preflight <BASE>，也没给 --allow-no-layer-preflight")
            print("  要做层前置：kb-review §1.5 驱动循环；确实不做：显式加 --allow-no-layer-preflight"
                  "（结论里会记 mode=waived_by_caller，不许静默）")
        return 3
    else:
        pf = {"base": None, "ok": True, "red_total": 0, "mode": "waived_by_caller", "details": {},
              "reason": "调用方显式声明不做层前置（--allow-no-layer-preflight）"}

    # ── 判定主体（fail-closed，防线2，2026-10-03 加）──────────────────────────
    # 为什么加：层前置只保护「**证据管道**」，不保护「**判定主体**」。实测同一日图片轮播那一单：
    #   四层审计红 0，但让位表指定的判定主体（`图片安全审查`）**一次都没加载**，报告照样出了 ——
    #   而引擎产的是「依据 + 三态」，**「这段该怎么判」归专项**。专项缺席必须挡在结论之前。
    # 与层前置同构（同一强度、同样可豁免、同样留痕），**不是第 7 把尺子**。
    if a.decision_owner:
        do = {"skill": a.decision_owner, "mode": "declared", "declared_by": "agent",
              "loaded_skills": list(a.loaded_skill or [])}
        if do["loaded_skills"] and a.decision_owner not in do["loaded_skills"]:
            do["warning"] = ("判定主体 %s **不在 --loaded-skill 申报里** ⇒ 声明与申报不一致；"
                             "本条是 agent 自述档，**不得当强证据**" % a.decision_owner)
    elif a.allow_no_decision_owner:
        do = {"skill": None, "mode": "waived_by_caller",
              "reason": "调用方显式声明不记判定主体（--allow-no-decision-owner）"}
    else:
        refusal = {
            "state": "NEEDS_INPUT", "decision": "NEEDS_INPUT",
            "summary": ("【审查结论：NEEDS_INPUT】判定主体缺失（fail-closed）：本跑没给 "
                        "--decision-owner <skill-id>，也没显式豁免。层前置只证明「证据管道通了」，"
                        "**不证明「有人按专项规程判过」**（实测：四层全绿而判定主体缺席，报告照样出）。"),
            "issue_count": 0,
            "decision_owner": {"skill": None, "mode": "absent"},
            "next_action": ("按 kb-review 让位表补上判定主体，例如：--decision-owner 图片安全审查 "
                            "（并用 skill 工具**真的加载它**）；确实不需要专项的场合请显式写 "
                            "--allow-no-decision-owner，让「缺判定主体」留在结论里"),
        }
        if a.json:
            print(json.dumps(refusal, ensure_ascii=False, indent=1))
        else:
            print("结论：NEEDS_INPUT（**判定主体缺失** —— 不出三态结论）")
            print("  没给 --decision-owner <skill-id>，也没给 --allow-no-decision-owner")
            print("  让位表怎么查：kb-review/SKILL.md 的让位表（图片/主图/图上文字 → 图片安全审查）")
            print("  确实不需要专项：显式加 --allow-no-decision-owner（结论里会记 mode=waived_by_caller）")
        return 3

    # ── 图片单专项闸门（fail-closed，2026-10-21 加）────────────────────────────
    #   为什么加：本机实测同一单「报告已发、判定主体那个 skill 一次没加载过」，而层前置与四道审计
    #   **全绿** —— 层前置保护的是「证据管道」，不保护「专项 skill 真的跑过」。
    _img_gate = None
    # 口径：判定「这是不是图片单」除了英文 `image`，也认几个**中文/别名**写法 ——
    #   否则写 `--content-type 主图` 就**绕过**了本闸门（实测口径坑：技能正文要求英文，
    #   但引擎历史上收过「主图 / 素材图」这类值）。认出来之后**照样要求英文 image**，
    #   只是不让你用别名把闸门绕过去。
    _ct_raw = (a.content_type or "").strip()
    _ct = _ct_raw.lower()
    _IMAGE_ALIASES = {"image", "主图", "图片", "素材图", "image/"}
    if _ct in _IMAGE_ALIASES:
        if _ct != "image":
            print("⚠️ --content-type=%r 是别名写法；图片单请用英文 `image`"
                  "（coverage 闸门只认英文，中文写法会让它静默失效）" % _ct_raw, file=sys.stderr)
        _img_gate = image_skill_gate(a)
        if not _img_gate["ok"]:
            refusal = {
                "state": "NEEDS_INPUT", "decision": "NEEDS_INPUT",
                "summary": ("【审查结论：NEEDS_INPUT】图片单专项闸门未过（fail-closed，原因码 %s）：%s"
                            % (_img_gate.get("reason_code"), "；".join(_img_gate["checks"]))),
                "issue_count": 0,
                "image_skill_gate": _img_gate,
                "next_action": ("图片单必须先让「图片安全审查」在 harness 侧**读得到**、"
                                "并用 skill 工具**真的加载过**，再重跑本命令；"
                                "文件坏了（信封态/坏 frontmatter）看 kb/l8/assert_skill_ready.py 头注释的修法。"),
            }
            if a.json:
                print(json.dumps(refusal, ensure_ascii=False, indent=1))
            else:
                print("结论：NEEDS_INPUT（**图片单专项闸门未过** —— 不出三态结论）")
                print("  原因码：%s" % _img_gate.get("reason_code"))
                for why in _img_gate["checks"]:
                    print("  · %s" % why)
                for w in _img_gate["warnings"]:
                    print("  ⚠️ %s" % w)
                print("  判据：kb/l8/assert_skill_ready.py（文件能否被 harness 读到）"
                      "＋ kb/l8/verify_skill_loaded.py（本会话有没有**真的**加载过）")
            return 3

    try:
        _cov_provided = _parse_coverage_specs(a.coverage)
    except ValueError as e:
        print("❌ --coverage 解析失败：%s" % e, file=sys.stderr)
        return 2

    # ★ 2026-10-20：`--image` —— 把「调用方真读过这几张图」换成**实算 sha256** 的 coverage 申报。
    #   优先级：显式 `--coverage` > `--image`（前者是人点名写的，后者由登记件推）。
    #   不给 `--image` ⇒ 行为与改动前**逐字一致**（声明的模态一律 incomplete）。
    if getattr(a, "image", None):
        try:
            _img_cov = _coverage_from_images(a.image, a.vision_provider, a.vision_provider_version)
        except ValueError as e:
            print("❌ --image 解析失败：%s" % e, file=sys.stderr)
            return 2
        _merged = dict(_cov_provided or {})
        for _k, _v in (_img_cov or {}).items():
            _merged.setdefault(_k, _v)
        _cov_provided = _merged or None
        if _cov_provided:
            _m = sorted((_img_cov or {}))
            print("模态申报：--image 实算 %d 张图 → %s（provider=%s @%s）"
                  % (len(a.image), "、".join(_m), a.vision_provider,
                     (a.vision_provider_version or "登记件默认")), file=sys.stderr)

    # ★ 本单发不发飞书 —— 决定要不要发业务号（见 `_auto_content_id`）。
    #   必须在 `run()` 之前设好：content_id 是在 run() 里算的。
    globals()["_PUBLISHING"] = not bool(getattr(a, "no_publish_to_feishu", False))
    res, err = run(a.text, content_id=a.content_id, channel=a.channel,
                   product_line=a.product_line, product_line_seed=a.product_line_seed,
                   # ★ 2026-10-06：把 `--write-report` 接进去。不给 ⇒ 与改动前逐字一致（不落盘）。
                   write_report=bool(a.write_report),
                   findings_from=a.findings_from, findings_out=a.findings_out,
                   decision_owner=do, loaded_skills=list(a.loaded_skill or []),
                   # ★ 2026-10-05 接上：CLI 的 --content-type 原先**只传给发布件**
                   #   （见下方 cmd 构造），从不进 run() ⇒ payload 永远写死 "text"，
                   #   于是 review_engine._coverage_ready() 里 `content_type == "image"`
                   #   那条判据永远收不到信号（图片送审被判"模态不适用"）。
                   content_type=(a.content_type or "text"),
                   # ★ 2026-10-05 加（用户裁定）：调用方申报的模态佐证。
                   #   不给 ⇒ 行为与改动前**逐字一致**（声明的模态一律 incomplete）。
                   coverage_provided=_cov_provided,
                   scene=_scene_from_arg(a),
                   # ★ 2026-10-20：复核人写的位置（不给 ⇒ 与改动前逐字一致）
                   position=getattr(a, "position", None))
    if res is None:
        print("❌ 跑不起来：%s" % err, file=sys.stderr)
        return 2
    res["evidence_meta"]["layer_preflight"] = pf      # 过了/豁免了都要留痕（可核性）
    # ★ 2026-10-20：谁写的位置要看得见（不给就记 None —— 缺位置必须可见，不许静默）
    res["evidence_meta"]["position"] = {
        "value": getattr(a, "position", None),
        "supplied_by": "reviewer(cli)" if getattr(a, "position", None) else None,
        "note": ("复核人按 Owner 2026-10-20 令写入（四形态）"
                 if getattr(a, "position", None) else
                 "未提供 ⇒ 依据层用默认位置（图片会是裸「图 1」，出口闸 R3 判红）"),
    }
    res["evidence_meta"]["decision_owner"] = do       # 同上：判了/豁免了都要留痕
    if _img_gate is not None:                          # 图片单专项闸门：过了/带告警都要留痕
        res["evidence_meta"]["image_skill_gate"] = _img_gate
    if a.json:
        pass          # ★ JSON 统一挪到最后打印 —— 要带上发布结果（publish），且 stdout 必须保持**纯 JSON**
    else:
        d = res["decision"]
        print("结论：%s" % (d.get("state") or d.get("decision")))
        # 库规模**运行时算**，不硬编码：原写死「509 条规则」，2026-09-30 已长到 1018 行
        # （见 kb/l7/registry/l7.json → article_no_source.total_rules_note：509 → 632）。
        # 不得用 evidence_meta.findings（那是本次**命中**条数，不是库规模），两者不是一个量。
        try:
            with open(KB / "l3/candidates/rules.jsonl", encoding="utf-8") as _f:
                _rules_n = sum(1 for _l in _f if _l.strip())
        except OSError:
            _rules_n = None
        print("依据命中 %s 处（检索时库内规则 %s 条 + P0 匹配；库规模按运行时实读，不硬编码）"
              % (res["evidence_meta"]["findings"],
                 _rules_n if _rules_n is not None else "读取失败"))
        _fs = res["evidence_meta"].get("findings_source") or {}
        if _fs.get("mode") == "cache":
            print("依据来源：复用缓存 %s @ %s（未重跑 review.py）"
                  % (_fs.get("path"), _fs.get("cached_at")))
        else:
            print("依据来源：本次现跑 review.py")
        if pf is not None:
            if not pf.get("details"):
                print("层前置：**未做**（mode=%s）—— 本结论**不构成**「走过 L4–L7」的证据"
                      % pf.get("mode"))
            else:
                print("层前置：%s ｜ 红合计 %s ｜ 会话 %s"
                      % (" / ".join("%s=%s" % (L, "✅" if r["pass"] else "❌")
                                    for L, r in pf["details"].items()),
                         pf["red_total"],
                         {L: ((r["skill_sessions"] or {}).get(L)
                              if isinstance(r["skill_sessions"], dict) else r["skill_sessions"])
                          for L, r in pf["details"].items()}))
        # 判定主体（防线2）：判了/豁免了都打出来 —— 跟层前置并列，缺了要一眼看见
        if do.get("skill"):
            print("判定主体：%s（%s）%s"
                  % (do["skill"], do["mode"],
                     " ｜ ⚠️ " + do["warning"] if do.get("warning") else ""))
        else:
            print("判定主体：**未记**（mode=%s）—— 本结论**不构成**「专项判过」的证据" % do.get("mode"))
        print(json.dumps(d, ensure_ascii=False, indent=1)[:1200])
    state = (res["decision"].get("state") or res["decision"].get("decision") or "").upper()

    # ── 自动发布到飞书（2026-10-03 加）──────────────────────────────────────
    # 为什么放在引擎里：用户只丢一句「审一下」＋素材时，**不该再被要求补"发到飞书"这句话**。
    # 链路自动化的最后一跳就是这里：引擎出完结论，自己调发布件。
    # 边界：NEEDS_INPUT 不发（没有三态结论）；层前置未过在更早处已经拒答、根本走不到这里；
    #       发布失败**不改结论**，只如实报"没发出去"。
    # ── 自动发布到飞书（2026-10-03 加；**默认开**）────────────────────────────
    # 为什么默认开：用户只丢一句「审一下」＋素材时，**不该再被要求补"发到飞书"这句话**，
    # 也不该因为模型漏了一个 flag 就只剩本地报告。默认发布 + `--no-publish-to-feishu` 显式关，
    # 与「层前置默认要求」同一套设计（默认严、要松必须写出来）。
    # 边界：NEEDS_INPUT 不发；层前置未过在更早处已拒答；发布失败**不改结论**，只如实报"没发出去"。
    state = (res["decision"].get("state") or res["decision"].get("decision") or "").upper()
    # ⚠️ `--json` 时发布过程的日志一律走 **stderr** —— stdout 必须保持纯 JSON，
    #    否则下游（`json.load`、别的消费者）会撞 "Extra data"（2026-10-03 实测踩过）。
    _emit = (lambda s: print(s, file=sys.stderr)) if a.json else print
    publish_rec = {"mode": "enabled" if not a.no_publish_to_feishu else "disabled_by_caller"}
    if a.no_publish_to_feishu:
        _emit("飞书发布：**已按 --no-publish-to-feishu 关闭** —— 本结论没有发出去")
        publish_rec.update({"published": False, "reason": "disabled_by_caller"})
    elif state not in ("PASS", "REVIEW", "BLOCK"):
        _emit("飞书发布：跳过（结论是 %s，没有三态结论可发）" % state)
        publish_rec.update({"published": False, "reason": "no_conclusion"})
    else:
        # ★ 用户原提问（2026-10-03 用户裁定 (a)+(b)）：先注入 review JSON ⇒ 报告正文能读到；
        #   再透传给发布件 ⇒ 写飞书「送审问题」列。
        if (a.question or "").strip():
            res["decision"]["submit_question"] = a.question.strip()
        tmpj = Path("/tmp/kb-review-%s.json" % (res["decision"].get("review_id") or "run"))
        tmpj.write_text(json.dumps(res, ensure_ascii=False), encoding="utf-8")
        # ★ 缺省**不许**填占位值「未指定」—— 发布件会把它**无条件写回表行**，
        #   从而把上一次真实送审留下的「内容类型 / 渠道 / 产品线」冲成占位值。
        #   实测两次（2026-10-03）：11:05 rev71 产品线「吸奶器」→「未指定」（非本单）；
        #   21:26 rev77 内容类型「广告语」→「未指定」（本单）。两次都已人工恢复原值。
        #   改为：缺省传空串 ⇒ 发布件**省略该键** ⇒ 行内旧值保留（省略键 = 不动）。
        # ★★ 2026-10-06 补：**空串不再等于"不填"** —— 命令行没给时改用 `material_facets`
        #   （见 `_derive_material_facets`）。原先不传就恒空 ⇒ 云文档恒是 `渠道：— ｜ 产品线：—`。
        _mf = (res.get("evidence_meta") or {}).get("material_facets") or {}
        _ch = (a.channel or "").strip() or str(_mf.get("channel") or "").strip()
        _pl = (a.product_line or "").strip() or str(_mf.get("product_line") or "").strip()
        _emit("飞书发布：素材属性 → 渠道=%r ｜ 产品线=%r（%s）"
              % (_ch, _pl,
                 "命令行给定" if ((a.channel or "").strip() or (a.product_line or "").strip())
                 else "由 l0_facets 推出：%s" % json.dumps(_mf.get("from") or {}, ensure_ascii=False)))
        cmd = [sys.executable, str(HERE / "feishu_publish.py"), "--review-json", str(tmpj),
               "--channel", _ch,
               "--product-line", _pl,
               "--content-type", a.content_type or "",
               "--question", a.question or "", "--apply"]
        if a.content_id:
            cmd += ["--content-id", a.content_id]
        _emit("飞书发布：自动调用 feishu_publish.py --apply …")
        p = subprocess.run(cmd, capture_output=True, text=True)
        out = ((p.stdout or "") + (p.stderr or "")).strip()
        for line in out.splitlines()[-7:]:
            if line.strip():
                _emit("  " + line)
        m = re.search(r"docx=(\S+)\s*｜\s*record=(\S+)", out)
        publish_rec.update({"published": p.returncode == 0,
                            "docx": (m.group(1) if m else None),
                            "record_id": (m.group(2) if m else None)})
        if p.returncode != 0:
            _emit("  ⚠️ 飞书发布失败（退出码 %s）—— **结论有效，但没发出去**" % p.returncode)
    res["evidence_meta"]["publish"] = publish_rec
    # ══════════════════════════════════════════════════════════════════════════
    # ★★ 2026-10-08（第四批）：**`report_url` 这一格原先没人填** —— 卡片因此给不出链接
    # ══════════════════════════════════════════════════════════════════════════
    # 实测链条（Owner 报「私聊有依据、群里没有」，逐环可核）：
    #   · 库侧判到 **≥3 条** ⇒ 按 PRD §5.3.3 只出分类汇总、**不出逐条**
    #     ⇒ 守衡侧的正则抽不出逐条 ⇒ 卡片里「库侧 0 条」（日志：`逐条抽出 0 条`）；
    #   · 兜底本该是**报告链接**（`dual_track.mjs::renderMerged` 早就写了
    #     `逐条明细在库里：${kb.reportUrl}`）—— 而它拿到的是 **null**；
    #   · 为什么 null：**`evidence_meta` 里根本没有 `report_url` 这个键**
    #     （只有 `report_path` 本地路径），旁挂 `pick("report_url")` ⇒ None ⇒
    #     卡片只能渲染成「（本次库侧未回报告链接）」。
    #   · 而**链接其实一直都在**：同一轮的 `evidence_meta.publish.docx`
    #     = `https://momcozy-in.feishu.cn/docx/OQZXdtSTFojTG4xLFVDcU8iYn5g`（真人点得开）。
    #   ⇒ 结论：**不是没链接，是这个格子没人填。**
    # 取值口径（**可点优先，本地路径只作兜底并如实标注**）：
    #   `publish.docx`（飞书云文档，可点） > `report_path`（本地 .md，**人点不开**）。
    #   两者都没有 ⇒ 留 None（**不编**）—— 卡片那边会照实写「未回报告链接」。
    _docx = publish_rec.get("docx") or None
    _rpath = res.get("evidence_meta", {}).get("report_path") or None
    res["evidence_meta"]["report_url"] = _docx or _rpath
    res["evidence_meta"]["report_url_kind"] = (
        "feishu_docx" if _docx else ("local_path" if _rpath else None))

    if a.json:                      # ★ 最后打印，且含 layer_preflight 与 publish 两项留痕
        print(json.dumps(res, ensure_ascii=False, indent=1))
    return 3 if state == "NEEDS_INPUT" else 0


if __name__ == "__main__":
    sys.exit(main())
