        if _ev_cov.get("covered") is False:
            _min = _ev_cov.get("coverage_bm25_min")
            # ★★ 2026-10-08（Owner 报「REVIEW N 处需人工确认，却一条依据都没有」）──
            #   **结论仍是 REVIEW**（保 2026-10-06 Owner 裁定的「不能拒答」，不动）；
