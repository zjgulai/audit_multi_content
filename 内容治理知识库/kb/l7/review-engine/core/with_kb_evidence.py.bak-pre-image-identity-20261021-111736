                      "（kb-review §1.5 驱动循环）")
            return 3
    elif not a.allow_no_layer_preflight:
        pf = {"base": None, "ok": False, "red_total": 0, "mode": "absent", "details": {},
              "reason": "未提供 --require-layer-preflight <BASE>，也未声明 --allow-no-layer-preflight"}
        refusal = {
            "state": "NEEDS_INPUT", "decision": "NEEDS_INPUT",
            "summary": ("【审查结论：NEEDS_INPUT】层前置缺失（fail-closed）：本跑既没给层前置 BASE，"
                        "也没显式豁免 —— 按 AGENTS「审查类任务 = 先跑层 → 再出结论」，"
                        "L4→L5→L6→L7 必须先逐个跑过并留下会话留痕（L7 也不例外：它是跨层闸门，"
                        "但**要单独跑并留会话痕**）"),
            "issue_count": 0, "layer_preflight": pf,
            "next_action": ("先跑 kb-review §1.5 的驱动循环得到 <BASE>，再带上 "
                            "--require-layer-preflight <BASE>；"
                            "确实不该做层前置的场合（如回归用例、机器入口）请显式写 "
