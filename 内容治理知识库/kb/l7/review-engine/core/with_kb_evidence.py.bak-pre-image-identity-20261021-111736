def run(text: str, *, content_id=None, channel="", product_line="", product_line_seed="",
        write_report: bool = False, findings_from=None, findings_out=None,
        decision_owner=None, loaded_skills=None,
        content_type: str = "text", coverage_provided=None, scene=None, position=None):
    ev, err = _evidence_findings(text, write_report=write_report,
                                 findings_from=findings_from, findings_out=findings_out,
                                 scene=scene, content_type=content_type, position=position)
    if ev is None:
        return None, err

    # ★★ 2026-10-09：**检索命中先算一次，三条返回支路都要带** ──────────────────
    #   病灶（Owner 的原话是「我后续发给守衡的**所有视频**都要带 命中原文+飞书链接」）：
    #   我第一版只把 `kb_hits` 塞进**覆盖缺口那一条**支路（`covered is False`）——
    #   于是**库真的命中了**（正常单子）的那些送审，`kb_hits` 根本不存在 ⇒ 卡上什么都没有。
    #   「所有视频都带」这个要求，靠一条支路**结构上就做不到**。
    #   ⇒ 在这里算一次（`ev` 在整个函数里都在作用域内），三条返回各自引用同一个值。
    #   ★ 只搬运、不参与判定：三态一个字不变。
    _kb_hits_all = kb_hits_of((ev.get("trace") or {}).get("units", {}).get("top_bm25")
                              if isinstance(ev.get("trace"), dict) else None)

    # ── ★★ 批30 附修：依据侧**拒答**必须原样传下去（fail-closed 不许被打穿）───────
    # 病灶（实测，2026-10-02）：
    #   `review.py` 拒答时 `exit=3` / `state=NEEDS_INPUT` / `findings=[]` / `refusal={…}`；
    #   而本函数**只取 `findings`**（下面 `:160` 那行），空 findings ⇒ `risk_items=[]`
    #   ⇒ `decide()` ⇒ **PASS**。⇒ **拒答被下游静默转成了放行**。
    #   两条路都走本函数：API 入口（`kb_api.py do_review`）与 AGENTS.md 步骤 ③
    #   —— 所以这条洞把批30 的强制点在 API 侧整个绕开（实测：HTTP **200 + state=PASS**，
    #   而同一段文案在依据侧是 `NEEDS_INPUT`）。
    # 修法（**最小接线**，与批次19 第2块同款：只改短路条件，**不动 `decide()`**）：
    #   依据侧说拒答 ⇒ 直接回 `NEEDS_INPUT`，**不喂给 `decide()`**。
    # ★ 2026-10-05 修：原先只认 "NEEDS_INPUT"，而 review.py 在「覆盖率不足」这条路上给的是
    #   中文 **"拒答"**（review.py:629 `state = "PASS" if covered else "拒答"`）——
    #   于是这条 if 对那条路**永远为假** ⇒ 空 findings 直落 decide() ⇒ **拒答被静默读成 PASS**
    #   并默认发布到飞书表（2026-10-05 实测已发生一次，见
    #   PMO/守衡-全链验收与两处缺陷-20261005.md §二）。
    #   实测对照（两次数出件）：
    #     第 1 次 ev["state"]="NEEDS_INPUT" → 命中，正确拒答；
    #     第 2 次 ev["state"]="拒答"        → **不命中** ⇒ disposition=PASS。
    #   判据不再靠单个字符串：同时认「哨兵值」与「覆盖信号」两条独立输入。
    _ev_state = str(ev.get("state") or "").strip().upper()
