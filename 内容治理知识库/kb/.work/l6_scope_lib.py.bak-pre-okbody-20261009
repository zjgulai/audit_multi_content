def frole(n):
    return "content" if n in CONTENT_FIELDS else ("metadata" if n in METADATA_FIELDS else "unknown")


def load_units(path="kb/l2/units.jsonl"):
    return [json.loads(l) for l in open(path, encoding="utf-8") if l.strip()]


def usable_units(units=None):
    """返回 (kept, FILTER)：口径与 kb/.work/l3_distill2.py 逐条一致。"""
    units = units if units is not None else load_units()
    FILTER = collections.Counter()
    kept = []
    # ★ 2026-10-05 提速（S3 · 纯重复计算，**判据一字未改**）：
    #   病灶（分段实测）：本函数 42.64 s，而 L6 闸门总共 54.7 s —— 贵在这里。
    #   原因：下面那两个集合与**单元无关**，却被写在逐单元循环里 ——
    #     12,213 个单元 ⇒ `manifest_l2.jsonl` 与 `retired_units.jsonl` 各被
    #     **重新打开+重新解析 12,213 次**。
    #   改法：循环外算一次。判定逻辑、集合内容、计数口径全部原样。
    _invalid = _invalidated_resources()
    _retired = _retired_unit_ids()
    for u in units:
        kb = u["kb_type"]
        if kb not in ("wording", "external_standard", "internal_sample"):
            FILTER[(kb, "out_of_scope_kb")] += 1
            continue
        _tbl = (u.get("meta") or {}).get("table") or u.get("heading_path")
        # ★ 2026-10-08 修：表级白名单**只对 bitable 来源生效**。
        #   病灶：wiki / url / media 类资源**没有 `table` 字段**，`_tbl` 于是回落到 `heading_path`
        #   —— 而那也是**容器表名**（实测值「材料收集」）⇒ 被这张表级白名单误挡。
        #   实测被误挡的是真内容：`Meta近期在投文案`（2,114 字）、达人信息、以及**视频关键帧文本所在的
        #   4 份达人内容稿**（这直接决定守衡能否检索到视频内容）。共 341 条。
        #   判据：只有 bitable 资源才有「表」可判；其他来源不做这道判（不是放宽尺寸、不是全放开）。
        _is_bitable = str(u.get("resource_id") or "").startswith("bitable__")
        if kb == "internal_sample" and _is_bitable and _tbl not in INTERNAL_SAMPLE_TABLES:
            FILTER[(kb, "out_of_scope_table")] += 1
            continue
        if len(u.get("text") or "") > MAX_UNIT_CHARS:
            FILTER[(kb, "oversize_gt_%d" % MAX_UNIT_CHARS)] += 1
            continue
        if u["unit_type"] == "entry" and frole(u.get("heading_path")) != "content":
            FILTER[(kb, "metadata" if frole(u.get("heading_path")) == "metadata"
                    else "metadata_unknown_field")] += 1
            continue
        flag = (u.get("meta") or {}).get("content_quality_flag")
        if flag and flag not in GOOD_QUALITY_FLAGS:
            FILTER[(kb, "quality_flag")] += 1
            continue
        if u.get("resource_id") in _invalid:
            FILTER[(kb, "l2_invalidated")] += 1
            continue
        if u["unit_id"] in _retired:
            FILTER[(kb, "l2_unit_retired")] += 1
            continue
        kept.append(u)
    return kept, FILTER


def apply_scope_file(kept, FILTER, path=None):
    """按 kb/l6/SCOPE.txt 把可用集合收窄为人工核定的白名单。

    **为什么要有这个函数**：SCOPE.txt 这个机制原先只被 kb/.work/l6_scope.py（报告器）读，
    而真正建索引的 kb/.work/l6_build.py 走的是本文件的 usable_units()，**不读 SCOPE.txt**。
    于是 registry 里那句 `scope_file: kb/l6/SCOPE.txt` 会在文件存在时声称「已按它取子集」，
    实际建索引根本没理会 —— 属静默失真的溯源声明。2026-09-29 F11 把读取接进本文件，
    让报告器与建索引器同源；口径只能有一份。

    返回 (收窄后的 kept, 被排除的条数, 说明 dict)。无 SCOPE.txt 时原样返回。
    """
    path = path or SCOPE_FILE
    if not os.path.exists(path):
        return kept, 0, None
    want = [l.strip() for l in open(path, encoding="utf-8")
            if l.strip() and not l.startswith("#")]
    wanted = set(want)
    have = {u["unit_id"] for u in kept}
    out = [u for u in kept if u["unit_id"] in wanted]
    removed = len(kept) - len(out)
    if removed:
        FILTER[("*", "outside_scope_file")] += removed
    return out, removed, {
        "specified": len(want),
        "distinct_specified": len(wanted),
        "hits": len(out),
        "excluded_from_usable": removed,
        "specified_but_not_usable": sorted(wanted - have),
    }


def p0_evidence_unit_ids(path="kb/l3/candidates/rules.jsonl"):
    """P0 规则的证据单元 id 集合。P0 不入向量（走 kb/l5/matcher.py 的确定性匹配）。"""
    latest = {}
    for l in open(path, encoding="utf-8"):
        if l.strip():
            r = json.loads(l)
            latest[r["rule_id"]] = r
    out = set()
    for r in latest.values():
        if r.get("p_level") == "P0":
            for u in r.get("evidence_units") or []:
                out.add(u["unit_id"])
    return out
