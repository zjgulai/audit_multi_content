INTERNAL_SAMPLE_TABLES = {"专家修订汇总表", "负面样本", "正面和负面样本"}
MAX_UNIT_CHARS = 8000
# 只放行「确认是干净正文」的标记；其余任何 quality_flag 一律照挡（勿放松，否则整页抓取会涌入）
GOOD_QUALITY_FLAGS = {"recrawl_headless_rendered", "pdf_ocr_vision"}


def _invalidated_resources(path="kb/l2/manifest_l2.jsonl"):
    latest = {}
    if not os.path.exists(path):
        return set()
    for l in open(path, encoding="utf-8"):
        if l.strip():
            r = json.loads(l)
            latest[r.get("resource_id")] = r.get("result")
    return {k for k, v in latest.items() if v == "invalidated"}


def _retired_unit_ids(path="kb/l2/retired_units.jsonl"):
    """单元级退役账（kb/l8/l2_align_current.py 写）。
    资源被重切后旧单元不删，只在这里记账 —— 所以索引侧必须读它，否则旧正文照进。"""
    if not os.path.exists(path):
        return set()
    out = set()
    for l in open(path, encoding="utf-8"):
        if l.strip():
            out.add(json.loads(l)["unit_id"])
    return out



