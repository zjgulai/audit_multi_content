    "正面和负面样本::具体内容（截图/文案/OCR）": "attachment"
  },
  "field_role_resolution": "先查 field_role_table_overrides 的「表名::字段名」，未命中再查 field_roles 裸字段名。存在同名不同角色的字段时必须写 override，避免误下钻。",
  "fingerprint_policy": {
    "primary": "sha256",
    "revision_as_aux": true,
    "hash_size_limit_mb": 2048,
    "normalization": {
      "encoding": "utf-8",
      "newline": "\\n",
      "strip_trailing_space": true,
      "collapse_blank_lines": true,
      "sort_keys": true,
      "exclude_fields": [
        "last_modified_time",
        "last_modified_by"
      ]
    },
    "sha256_input_by_source_kind": {
      "feishu_bitable_record": "record_fields",
      "feishu_bitable_table": "structure",
      "feishu_bitable_base": "structure",
      "feishu_doc": "doc_text",
      "feishu_sheet": "doc_text",
      "feishu_slides": "doc_text",
      "feishu_attachment": "file_bytes",
      "feishu_file": "file_bytes",
      "feishu_wiki_node": "structure",
      "url": "url_text"
    }
  },
  "excluded_policy": "记录未命中「材料审核状态 = 通过」时不登记为资源，只进入 runs/<run_id>.json 的排除清单，原因枚举：no_status / status_not_passed / status_unsupported",
  "unmatched_policy": "kb_type=unknown，单独汇总，不猜",
  "kb_version": "v0"
