{
 "_comment": "L0 原始库映射规则。机器判断分类一律查 dir_map，不要硬编码中文目录名。分类只能靠重跑改，不手工 mv/重命名。规则生效与否看每条规则的 enabled（缺省为 true）；停用规则不参与求值。",
 "kb_version": "v0",
 "dir_map": {
  "1_外部标准库": "external_standard",
  "2_内部正负样本库": "internal_sample",
  "3_措辞表达库": "wording",
  "4_产品描述库": "product_desc",
  "9_未归类": "unknown"
 },
 "dir_map_reverse": {
  "external_standard": "1_外部标准库",
  "internal_sample": "2_内部正负样本库",
  "wording": "3_措辞表达库",
