 "field_role_resolution": "先查 field_role_table_overrides 的「表名::字段名」，未命中再查 field_roles 裸字段名。同名不同角色必须写覆盖。L0 是唯一真相：下游不得自建补丁角色表。",
 "fingerprint_policy": {
  "primary": "sha256",
  "revision_as_aux": true,
  "hash_size_limit_mb": 2048,
  "normalization": {
   "encoding": "utf-8",
   "newline": "\\n",
   "strip_trailing_space": true,
   "collapse_blank_lines": true,
   "sort_keys": true,
   "exclude_fields": [
    "last_modified_time",
    "last_modified_by"
   ]
  },
  "sha256_input_legend": {
   "doc_text": "文档内容，按 normalization 规范化后的文本",
   "record_fields": "记录全部字段原值，按 field_id 升序键序列化后（剔除 exclude_fields）",
   "file_bytes": "附件文件字节流；超 hash_size_limit_mb 不哈希",
   "url_text": "抓取到的网页正文，按 normalization 规范化后",
   "structure": "结构化资源（Base / 表）的字段 id、名称、类型、选项确定性序列化"
  }
 },
 "filter": {
  "field": "材料审核状态",
