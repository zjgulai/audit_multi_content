 "ledger_divergence_conclusion": {
  "defined_at": "20260924-1512",
  "long_lived": true,
  "subject": "local:review-case:img-1..4（4 张评测对照报告案图）的 L0 台账 vs L1 台账",
  "observed": {
   "l0_manifest_rows_for_these_keys": 0,
   "l1_manifest_rows_for_these_keys": 8,
   "l1_composition": "extracted 4（run 20260924-1200）+ invalidated 4（run 20260924-1210）"
  },
  "verdict": "**L0 无这些行是对的；L1 保留的 8 行是历史留痕，也是对的。两边不是矛盾，是「权威口径」与「审计留痕」的分工。**",
  "basis": [
   "口径一（源侧投影）：L0 的定义是「L0 == 源侧投影」（见 source_kind_retired[0].reason）。local_file 不是源侧入口，4 张案图已按用户裁决（user_decision_20260924）移出知识库，所以 L0 台账里**不应该有这 4 个 key 的有效行**。写者删掉它们，在「该不该在库里」这个方向上是对的。",
   "口径二（append-only）：台账是 append-only 的审计面。撤回决定的痕迹必须留。正确做法是「保留 12 行不动 + 追加行说明已撤出索引」，而不是「删行」。写者用删达成目的，破坏了审计面 —— 这一点是错的，已由本批的 ledger_rows_unauthorizedly_deleted 行留痕。",
   "L1 侧：kb/l1/README.md 未声明「L1 == 源侧投影」；L1 台账的主键是(resource_id, extractor_version, source_sha256)，它的 invalidated 行写明「L1 产物保留供审计但不再是有效内容」—— 这正是审计面该有的样子，无需改动。"
  ],
  "action": "只登记结论，不改数据：L0 不回填 12 行；L1 8 行保留原样。",
  "residual": "l1/index/l1.jsonl 里这 4 个 key 的单元行已在 run 20260924-1115 的 14:35:46 pass 中移除（index 回到 14782），与「L1 台账保留、索引不含」的处理一致，无残留。"
 },
 "ledger_audit": {
  "defined_at": "20260924-1512",
  "why": "本批往 l0/manifest.jsonl 追加了一行非资源行（change=ledger_rows_unauthorizedly_deleted）。为免它变成一个来路不明的枚举，在此登记。",
  "row_resource_key_prefix": "audit:",
  "row_status_enum_added": [
   "audit_note"
  ],
  "row_schema": "与资源行同 schema，但 source_kind/sha256/path/table_* 等资源字段为 null；审计细节放 audit{} 子对象。",
  "consumer_note": "按 (resource_key, observed_at) 取最新行的消费者不受影响：audit 行的 key 前缀是 audit:，不在任何 bitable:/url:/wiki: 资源命名空间内；kb_l0_scan_lib.ledger_keys_of_table 按 `bitable:<table_id>:` 前缀过滤，天然排除本行。",
  "pointer_resolution_policy": "「路径型引用可解析」分两类判：①**live 指针**（registry 里指向当前仍在用的位置，如 archived_to / excluded_scope.archived_to）—— 必须存在；②**历史指针**（台账行里的 moved_to / path，只描述「当时的去向」）—— 若该 key 的**最新行**状态不是gone/retracted，则该历史指针视为**已被后续行取代**，不算悬空。实测：gone 202/202 解析成功；restored 15/15 解析成功；retracted 16 行中 15 行的 moved_to 指向rulelib 归档，而这 15 个 key 的最新行均为 restored（文件已回到 kb/l0/1_外部标准库/）→ 属类②，非悬空；剩下 1 行解析成功。"
 },
 "container_policy": {
  "defined_at": "20260924-1512",
  "defined_before_run": true,
  "purpose": "把「归哪个库」(kb_type) 与「要不要发射单元」(container) 解耦。此前发射器拿 kb_type 当发射开关用：unknown → R5 → 一个不产单元的 splitter。结果是分类一旦修真（走 rule_for 真求值），立刻会放出 101 个元数据角色的噪声单元。",
  "criteria": [
