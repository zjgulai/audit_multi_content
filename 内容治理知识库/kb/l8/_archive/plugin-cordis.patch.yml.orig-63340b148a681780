# dsh-kb 的 profile 补丁层。
#
# 本包在 package.json 里声明 `dsh.bundle.patch` 指向本文件，所以
# `dsh plugin --profile desktop add <本包>` 之后，这一层会被追加到 profile 的
# bundle 栈里（在 dsh-base / dsh-web-app 之后、用户自己的 cordis.patch.yml 之前）。
#
# 一行的 insert 就够了：把知识库模块挂进组合。

- insert:
    - id: kb
      name: 'dsh-kb'
      config:
        # 知识库根目录。改这里就能让模块指向另一个库。
        # 总库 = Momcozy知识库，子库直接挂在它下面（没有中间的 kb/ 层）。
        root: '/Users/lute/.dsh/Momcozy知识库'
        # 单个条目正文的返回上限（字节）。超了会被截断并告警，
        # 防止一次 kb_read 把上下文撑爆。
        maxBodyBytes: 64000
        # kb_search 默认返回的候选条数上限。
        defaultSearchLimit: 20
