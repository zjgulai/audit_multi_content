import glob
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time

RUN = next((a for a in sys.argv[1:] if not a.startswith("--")), time.strftime("%Y%m%d-%H%M%S"))
APPLY = "--apply" in sys.argv
ONLY = [t for t in (sys.argv[sys.argv.index("--only") + 1].split(",") if "--only" in sys.argv else []) if t]
SCENE = float(sys.argv[sys.argv.index("--scene") + 1]) if "--scene" in sys.argv else 0.3
EVERY = float(sys.argv[sys.argv.index("--every") + 1]) if "--every" in sys.argv else 10.0
MIN_F = int(sys.argv[sys.argv.index("--min-frames") + 1]) if "--min-frames" in sys.argv else 8
MAX_F = int(sys.argv[sys.argv.index("--max-frames") + 1]) if "--max-frames" in sys.argv else 40
BATCH = 12
VID_DIR = "kb/l0/attachments/视频"
L1 = "kb/l1"
CACHE = f"{L1}/media/_cache"
FRAME_CHUNK = 2000          # 单段文本上限（帧文字都短，2000 足够且好定位）

import imageio_ffmpeg  # noqa: E402
FFMPEG = imageio_ffmpeg.get_ffmpeg_exe()


def sha_file(p):
    h = hashlib.sha256()
    with open(p, "rb") as fh:
        for b in iter(lambda: fh.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def hhmmss(t):
    t = int(max(0, t))
    return "%02d:%02d:%02d" % (t // 3600, (t % 3600) // 60, t % 60)


def probe(p):
    r = subprocess.run([FFMPEG, "-hide_banner", "-i", p], capture_output=True, text=True)
    e = r.stderr
    d = re.search(r"Duration: (\d+):(\d+):([\d.]+)", e)
    v = re.search(r"Video: (\w+).*?, (\d+)x(\d+)", e)
    dur = (int(d.group(1)) * 3600 + int(d.group(2)) * 60 + float(d.group(3))) if d else None
    return {"duration": round(dur, 2) if dur else None,
            "codec": v.group(1) if v else None,
            "width": int(v.group(2)) if v else None, "height": int(v.group(3)) if v else None}


def scene_times(p):
    """返回场景切换时间点（秒）。"""
    r = subprocess.run([FFMPEG, "-hide_banner", "-i", p, "-vf",
                        f"select='gt(scene,{SCENE})',showinfo", "-f", "null", "-"],
                       capture_output=True, text=True)
    ts = [float(x) for x in re.findall(r"pts_time:([\d.]+)", r.stderr)]
    return sorted(set(round(x, 2) for x in ts))


def pick_times(p, dur):
    ts = scene_times(p)
    if dur is None:
        return ts[:MAX_F]
    if len(ts) < MIN_F:                      # 补定点帧
        extra = [round(i * EVERY, 2) for i in range(1, int(dur // EVERY) + 1)]
        ts = sorted(set(ts) | set(extra))
    if len(ts) > MAX_F:                      # 等距抽稀
        step = len(ts) / MAX_F
        ts = [ts[int(i * step)] for i in range(MAX_F)]
    return ts


def extract_frames(p, times, outdir):
    """按时间点抽帧。返回 [(t, path)]，抽不出的跳过。"""
    os.makedirs(outdir, exist_ok=True)
    got = []
    for t in times:
        fp = f"{outdir}/t{int(round(t*1000)):07d}.png"
        if not os.path.exists(fp):
            subprocess.run([FFMPEG, "-hide_banner", "-loglevel", "error", "-ss", str(t),
                            "-i", p, "-frames:v", "1", "-y", fp],
                           capture_output=True, timeout=300)
        if os.path.exists(fp) and os.path.getsize(fp) > 1024:
            got.append((t, fp))
    return got


def ocr_frames(frames):
    """走既有 Vision 通道 + 既有缓存（键 = 图片 sha256）。返回 {path: (文本, 命中缓存)}。"""
    out = {}
    todo = []
    for _, fp in frames:
        h = sha_file(fp)
        cf = f"{CACHE}/{h}.json"
        hit = False
        if os.path.exists(cf):
            try:
                c = json.load(open(cf, encoding="utf-8"))
                if c.get("ocr_version") == "vision-jxa-2.0" and c.get("sha256") == h:
                    out[fp] = (c.get("ocr_text") or "", True)
                    hit = True
            except Exception:
                pass
        if not hit:
            todo.append(fp)
    for i in range(0, len(todo), BATCH):
        chunk = todo[i:i + BATCH]
        outj = f"/tmp/_kf_ocr_{os.getpid()}_{i//BATCH:03d}.json"
        subprocess.run(["osascript", "-l", "JavaScript", "kb/.work/ocr.jxa.js", outj, *chunk],
                       capture_output=True, timeout=1800)
        by = {}
        if os.path.exists(outj):
            try:
                for d in json.load(open(outj, encoding="utf-8")):
                    by[d.get("file")] = "\n".join(l.get("text", "") for l in (d.get("lines") or []))
            except Exception:
                pass
        for fp in chunk:
            txt = by.get(fp, "")
            out[fp] = (txt, False)
            if APPLY and txt:
                h = sha_file(fp)
                os.makedirs(CACHE, exist_ok=True)
                json.dump({"sha256": h, "sha256_state": "full", "ocr_version": "vision-jxa-2.0",
                           "ocr_text": txt, "engine": "macOS Vision(VNRecognizeTextRequest)",
                           "at": RUN, "src": "video_keyframe"},
                          open(f"{CACHE}/{h}.json", "w", encoding="utf-8"),
                          ensure_ascii=False, indent=1)
        for fp in chunk:
            if os.path.exists(outj):
                pass
        try:
            os.remove(outj)
        except Exception:
            pass
    return out


def build_segments(frames, ocr):
    """按时间窗成段；相邻帧文本相同则合并时间窗（口播视频常见）。"""
    segs, seen_norm = [], {}
    for idx, (t, fp) in enumerate(frames):
        txt, _ = ocr.get(fp, ("", False))
        if not txt.strip():
            continue
        t_end = frames[idx + 1][0] if idx + 1 < len(frames) else t + 1.0
        norm = re.sub(r"\s+", " ", txt).strip().lower()
        if norm in seen_norm:                # 文本重复 ⇒ 只延长已有段的时间窗
            j = seen_norm[norm]
            segs[j]["_t_end"] = max(segs[j]["_t_end"], t_end)
            continue
        seen_norm[norm] = len(segs)
        segs.append({"text": txt[:FRAME_CHUNK], "t": t, "_t_end": t_end, "frame": os.path.basename(fp)})
    for s in segs:
        s["anchor"] = f"#t.{hhmmss(s['t'])}-{hhmmss(s['_t_end'])}"
    return segs


# ── 目标：本地已下载的视频 ──
vids = []
for f in sorted(glob.glob(f"{L1}/*/*.json")):
    if "/_archive/" in f:
        continue
    try:
        d = json.load(open(f, encoding="utf-8"))
    except Exception:
        continue
    if not isinstance(d, dict):
        continue
    for m in (d.get("media_refs") or []):
        if not (isinstance(m, dict) and m.get("kind") == "video"):
            continue
        if ONLY and m.get("file_token") not in ONLY:
            continue
        p = m.get("media_path")
        if not p or not os.path.exists(p):
            continue
        vids.append({"artifact": f, "token": m.get("file_token"), "name": m.get("name"),
                     "path": p, "bytes": m.get("bytes")})

print(f"[{RUN}] 视频关键帧{'【落盘】' if APPLY else '【干跑】'}｜场景阈值 {SCENE}｜"
      f"每片帧上限 {MAX_F}｜目标 {len(vids)} 个视频（只处理字节已在本地、且 sha 已登记的）")
report = []
for v in vids:
    t0 = time.time()
    pr = probe(v["path"])
    times = pick_times(v["path"], pr["duration"])
    slug = re.sub(r"[^\w.-]", "_", os.path.basename(v["path"]))[:60]
    outdir = f"{L1}/media/video_{slug}/frames"
    if not APPLY:
        print(f"  · {os.path.basename(v['path'])[:42]:44s} {pr['duration']}s "
              f"{pr['width']}x{pr['height']} → 计划抽 {len(times)} 帧【干跑】")
        report.append({**v, "probe": pr, "planned_frames": len(times)})
        continue
    frames = extract_frames(v["path"], times, outdir)
    ocr = ocr_frames(frames) if frames else {}
    segs = build_segments(frames, ocr)
    chars = sum(len(s["text"]) for s in segs)
    hits = sum(1 for x in ocr.values() if x[1])
    ent = {**v, "probe": pr, "frames_extracted": len(frames), "cache_hits": hits,
           "segments": len(segs), "chars": chars, "seconds": round(time.time() - t0, 1),
           "frames_dir": outdir}
    report.append(ent)
    print(f"  ✓ {os.path.basename(v['path'])[:42]:44s} {pr['duration']}s → 帧 {len(frames)}"
          f"（缓存命中 {hits}）｜段 {len(segs)} / {chars} 字｜{ent['seconds']}s", flush=True)
    if segs:
        art = v["artifact"]
        d = json.load(open(art, encoding="utf-8"))
        vsegs = d.get("video_ocr_segments") or []
        vsegs = [x for x in vsegs if x.get("video_token") != v["token"]]
        vsegs.append({"video_token": v["token"], "video_name": v["name"],
                      "video_path": v["path"], "duration": pr["duration"],
                      "codec": pr["codec"], "width": pr["width"], "height": pr["height"],
                      "frames_dir": outdir, "frames_extracted": len(frames),
                      "extracted_at": RUN, "engine": "ffmpeg(scene)+macOS Vision",
                      "anchors": [s["anchor"] for s in segs],
                      "segments": [{"kind": "video_ocr", "text": s["text"],
                                    "anchor": s["anchor"], "frame": s["frame"],
                                    "t_start": s["t"], "t_end": s["_t_end"]} for s in segs]})
        d["video_ocr_segments"] = vsegs
        d["video_ocr_segment_count"] = sum(len(x["segments"]) for x in vsegs)
        d["video_ocr_char_count"] = sum(len(s["text"]) for x in vsegs for s in x["segments"])
        d["video_ocr_extracted_at"] = RUN
        tmp = art + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(d, fh, ensure_ascii=False, indent=1)
        json.load(open(tmp, encoding="utf-8"))
        os.replace(tmp, art)

tot_f = sum(e.get("frames_extracted") or 0 for e in report)
tot_c = sum(e.get("chars") or 0 for e in report)
print(f"  小结：视频 {len(report)} 个｜帧 {tot_f}｜可检索文本 {tot_c} 字")
json.dump({"run": RUN, "kind": "video_keyframe_ocr", "apply": APPLY, "scene": SCENE,
           "every": EVERY, "min_frames": MIN_F, "max_frames": MAX_F, "results": report},
          open(f"kb/l8/runs/{RUN}-video-keyframes.json", "w", encoding="utf-8"),
          ensure_ascii=False, indent=1)
print(f"  [报告] kb/l8/runs/{RUN}-video-keyframes.json")


